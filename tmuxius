    r"(?i)^(?:ran|explored|edited|read|searched|waited|waiting|viewed|called|"
    r"updated plan|context compacted|used|inspected|opened|found|listed|wrote|"
    r"working|computing)\b"
)
PROMPT_PLACEHOLDER_RE = re.compile(
    r"(?i)^(?:run /review|ask anything|explain this codebase|try [\"']?|"
    r"type /|what would you like|implement\s+\{feature\}|"
    r"fix a bug in @filename|write tests for @filename)"
)
