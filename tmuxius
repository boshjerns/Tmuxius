    r"^(?:[-*+]\s+|\d+[.)]\s+|#{1,6}\s+|>\s+|`{3}|~{3}|\|\s*|"
    r"[┌┐└┘├┤┬┴┼│─━┄┈]|tab to queue message\b|esc to interrupt\b)",
    re.IGNORECASE,
)
BUSY_RE = re.compile(
    r"^\s*(?:"
    r"(?:[◦•]\s*)?(?:working|computing)\s*\([^\n)]*"
    r"(?:esc to interrupt|press esc to cancel)[^\n)]*\)(?:\s*·[^\n]*)?"
    r"|[✻✽✢·*]\s*[^\n()]{1,80}\([^\n)]*"
    r"(?:esc to interrupt|press esc to cancel)[^\n)]*\)(?:\s*·[^\n]*)?"
    r"|computing…|waiting for background terminal(?:…)?|running command(?:…)?"
    r")\s*$",
    re.IGNORECASE | re.MULTILINE,
)
BUSY_DURATION_RE = re.compile(
    r"(?i)\b(?:working|computing)\s*\(\s*"
    r"(?:(\d+)h\s*)?(?:(\d+)m\s*)?(\d+)s\b"
)
BUSY_TICK_RE = re.compile(
