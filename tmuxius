def draw_preview_line(
    screen: curses.window,
    y: int,
    x: int,
    line: PreviewLine,
    width: int,
    palette: dict[str, int],
    status_attribute: int | None = None,
) -> None:
    if line.kind == "blank":
        return
    if line.kind == "working" and status_attribute is not None:
        # Reuse the parsed line kind, including wrapped status continuations.
        # Native dim styling must not obscure the panel's identifying color.
        curses_add(
            screen, y, max(0, x - 1), " " * (width + 2), status_attribute, width + 2
        )
        curses_add(screen, y, x, line.text, status_attribute, width)
        return
    if line.kind == "separator":
        try:
            screen.addstr(y, x, "─" * width, palette["dim"])
        except curses.error:
            pass
        return
    if not line.spans:
        curses_add(screen, y, x, line.text, preview_style(line, palette), width)
        return

    cursor = 0
    draw_x = x
    end_x = x + width
    fallback = preview_style(line, palette)
    for span in line.spans:
        if draw_x >= end_x:
            break
        if span.start > cursor:
            draw_x = curses_add(
                screen,
                y,
                draw_x,
                line.text[cursor : span.start],
                fallback,
                end_x - draw_x,
            )
        draw_x = curses_add(
            screen,
            y,
            draw_x,
            line.text[span.start : span.end],
            captured_style_attribute(span.style),
            end_x - draw_x,
        )
        cursor = max(cursor, span.end)
    if cursor < len(line.text) and draw_x < end_x:
        curses_add(
            screen,
            y,
            draw_x,
            line.text[cursor:],
            fallback,
            end_x - draw_x,
        )


def selected_workspace_index(
    workspaces: list[Workspace], selected_session_id: str | None
) -> int:
    if not workspaces:
        return 0
    for index, workspace in enumerate(workspaces):
        if workspace.session.session_id == selected_session_id:
            return index
    return 0


def dashboard_slot_count(state: DashboardState) -> int:
    return 2 if state.split_view else 1


def dashboard_active_session_id(state: DashboardState) -> str | None:
    slot = max(0, min(dashboard_slot_count(state) - 1, state.active_slot))
    return state.selected_session_ids[slot]


def dashboard_displayed_session_ids(state: DashboardState) -> tuple[str, ...]:
    return tuple(
        session_id
        for session_id in state.selected_session_ids[: dashboard_slot_count(state)]
        if session_id is not None
    )


def dashboard_focus_modes(split_view: bool) -> tuple[str, ...]:
    """Return the horizontal control modes available in the current view."""
    return ("window", "nav", "compose") if split_view else ("nav", "compose")


def dashboard_focus_step(focus: str, split_view: bool, delta: int) -> str:
    """Move left or right through the control modes without wrapping."""
    modes = dashboard_focus_modes(split_view)
    try:
        index = modes.index(focus)
    except ValueError:
        index = 0
    return modes[max(0, min(len(modes) - 1, index + delta))]


def dashboard_vertical_context(focus: str, split_view: bool) -> str:
    """Identify what Up/Down and wheel gestures control in this mode."""
    if focus == "window":
        return "window" if split_view else "workspace"
    if focus == "nav":
        return "workspace"
    return "preview"


def dashboard_focus_chip_ranges(
    panel_x: int, split_view: bool
) -> tuple[tuple[str, int, int], ...]:
    """Return the inclusive/exclusive x ranges used by clickable mode chips."""
    cursor_x = panel_x + 1
    ranges: list[tuple[str, int, int]] = []
    for mode in dashboard_focus_modes(split_view):
        end_x = cursor_x + len(DASHBOARD_FOCUS_LABELS[mode])
        ranges.append((mode, cursor_x, end_x))
        cursor_x = end_x + 1
    return tuple(ranges)


def dashboard_focus_at_x(
    panel_x: int, split_view: bool, mouse_x: int
) -> str | None:
    for mode, start_x, end_x in dashboard_focus_chip_ranges(
        panel_x, split_view
    ):
        if start_x <= mouse_x < end_x:
            return mode
    return None


def dashboard_table_capacity(height: int, split_view: bool = False) -> int:
    # Reserve chat headings, readable transcripts, one control row, and a gutter.
    reserved_rows = 15 if split_view else 11
    return max(1, min(12, height - reserved_rows))


def dashboard_workspace_bottom(
    height: int, workspace_count: int, split_view: bool = False,
    collapsed: bool = False,
) -> int:
    if collapsed:
        return 1
    table_capacity = dashboard_table_capacity(height, split_view)
    return 3 + min(workspace_count, table_capacity)


def dashboard_panel_geometries(
    usable_width: int,
    height: int,
    workspace_bottom: int,
    split_view: bool,
    active_slot: int = 0,
) -> tuple[DashboardPanelGeometry, ...]:
    chat_top = workspace_bottom + 1
    if not split_view:
        return (
            DashboardPanelGeometry(
                x=0,
                width=usable_width,
                chat_top=chat_top,
                chat_bottom=height - 3,
                composer_top=height - 2,
                composer_middle=height - 2,
                composer_bottom=height - 2,
            ),
        )

    region_bottom = height - 2
    gap = 1
    available_rows = max(2, region_bottom - chat_top + 1 - gap)
    top_rows = available_rows // 2
    bottom_rows = available_rows - top_rows
    regions = (
        (chat_top, chat_top + top_rows - 1),
        (chat_top + top_rows + gap, chat_top + top_rows + gap + bottom_rows - 1),
    )
    return tuple(
        DashboardPanelGeometry(
            x=0,
            width=usable_width,
            chat_top=region_top,
            chat_bottom=region_end - 1 if slot == active_slot else region_end,
            composer_top=region_end if slot == active_slot else -1,
            composer_middle=region_end if slot == active_slot else -1,
            composer_bottom=region_end if slot == active_slot else -1,
        )
        for slot, (region_top, region_end) in enumerate(regions)
    )


def default_workspace_session_id(workspaces: list[Workspace]) -> str | None:
    if not workspaces:
        return None
    selected = max(
        workspaces,
        key=lambda workspace: (
            bool(workspace.session.attached and workspace.state == "busy"),
            workspace.state == "busy",
            bool(workspace.session.attached),
            workspace.last_activity or 0,
        ),
    )
    return selected.session.session_id


def draw_chat_panel(
    screen: curses.window,
    workspace: Workspace,
    dashboard_state: DashboardState,
    palette: dict[str, int],
    now: float,
    *,
    x: int,
    width: int,
    top: int,
    bottom: int,
    label: str,
    active: bool,
) -> None:
    inner_x = x + 1
    inner_width = max(1, width - 2)
    title = (
        f"{label} / {safe_label(workspace.session.name)} / "
        f"{workspace_subject(workspace)}"
    )
    panel_style = "panel_bottom" if label == "BOTTOM" else "panel_top"
    draw_section_heading(
        screen, top, width, title, palette, x=x,
        style=panel_style,
    )
    meta_y = top + 1
    preview_start = meta_y + 1
    preview_rows = max(0, bottom - preview_start + 1)
    requested_scroll = dashboard_state.preview_scroll.get(
        workspace.session.session_id, 0
    )
    layout = dashboard_state.preview_layouts.get(workspace.session.session_id)
    if (
        layout is None
        or layout.source is not workspace.preview
        or layout.width != inner_width
    ):
        layout = PreviewLayout(
            workspace.preview,
            inner_width,
            wrap_preview_lines(workspace.preview, inner_width),
        )
        dashboard_state.preview_layouts[workspace.session.session_id] = layout
    preview, scroll_offset, _ = preview_window_from_wrapped(
        layout.wrapped,
        preview_rows,
        requested_scroll,
    )
    dashboard_state.preview_scroll[workspace.session.session_id] = scroll_offset
    cursor_x = inner_x
    cursor_x = curses_add(
        screen, meta_y, cursor_x, workspace.app.upper(), palette["cyan"]
    )
    cursor_x = curses_add(screen, meta_y, cursor_x, "  ", palette["normal"])
    tier = activity_tier(workspace.last_activity, workspace.state, now)
    state_field = lifecycle_label(workspace.state, tier).upper()
    if tier == "busy":
        cursor_x = curses_add_busy(
            screen, meta_y, cursor_x, state_field, palette
        )
    else:
        cursor_x = curses_add(
            screen,
            meta_y,
            cursor_x,
            state_field,
            palette.get(tier, palette["dim"]),
        )
    cursor_x = curses_add(screen, meta_y, cursor_x, "  ", palette["normal"])
    age = format_activity_age(workspace.last_activity, now)
    cursor_x = curses_add(
        screen,
        meta_y,
        cursor_x,
        age,
        palette["busy_0"] if tier == "busy" else palette.get(tier, palette["dim"]),
        max(0, x + width - cursor_x - 2),
    )
    if workspace.state == "busy" and x + width - cursor_x > 10:
        cursor_x = curses_add(screen, meta_y, cursor_x, "  ", palette["normal"])
        curses_add(
            screen,
            meta_y,
            cursor_x,
            format_elapsed(workspace.busy_seconds),
            palette["busy_3"],
            max(0, x + width - cursor_x - 2),
        )
    view_label = "LIVE" if scroll_offset == 0 else f"+{scroll_offset}"
    view_x = x + width - display_width(view_label) - 3
    if view_x > cursor_x + 1:
        curses_add(
            screen,
            meta_y,
            view_x,
            view_label,
            palette["busy_0"] if scroll_offset == 0 else palette["orange"],
        )

    preview_y = preview_start + max(0, preview_rows - len(preview))
    for offset, line in enumerate(preview):
        draw_preview_line(
            screen,
            preview_y + offset,
            inner_x,
            line,
            inner_width,
            palette,
            status_attribute=palette[panel_style],
        )
    if not preview and preview_rows:
        curses_add(
            screen,
            preview_start,
            inner_x,
            "No safe transcript yet.",
            palette["dim"],
            inner_width,
        )


def dashboard_draft(
    state: DashboardState, session_id: str
) -> tuple[str, int, dict[str, str]]:
    if state.active_draft_session == session_id:
        return state.text, state.cursor, state.paste_payloads
    text = state.drafts.get(session_id, "")
    return (
        text,
        min(len(text), state.draft_cursors.get(session_id, len(text))),
        state.draft_paste_payloads.get(session_id, {}),
    )


def draw_composer_panel(
    screen: curses.window,
    workspace: Workspace,
    dashboard_state: DashboardState,
    palette: dict[str, int],
    *,
    x: int,
    width: int,
    middle: int,
    label: str,
    active: bool,
) -> tuple[int, int] | None:
    sending_here = (
        dashboard_state.sending
        and dashboard_state.inflight_session == workspace.session.session_id
    )
    cursor_x = x + 1
    modes = dashboard_focus_modes(dashboard_state.split_view)
    for index, mode in enumerate(modes):
        chip_attribute = (
            palette["topbar"]
            if active and dashboard_state.focus == mode
            else palette["dim"]
        )
        cursor_x = curses_add(
            screen,
            middle,
            cursor_x,
            DASHBOARD_FOCUS_LABELS[mode],
            chip_attribute,
        )
        if index < len(modes) - 1:
            cursor_x = curses_add(
                screen, middle, cursor_x, " ", palette["normal"]
            )

    if active and dashboard_state.focus == "window":
        hint = f"  {label} ACTIVE · Up/Down panels"
        curses_add(
            screen,
            middle,
            cursor_x,
            hint,
            palette["selected"],
            max(1, x + width - cursor_x - 1),
        )
        return None

    if active and dashboard_state.focus == "nav":
        cursor_x = curses_add(screen, middle, cursor_x, "  ", palette["normal"])
        selector = dashboard_state.selector or "_"
        cursor_x = curses_add(
            screen, middle, cursor_x, selector, palette["selected"]
        )
        hint = "  Up/Down or number"
        curses_add(
            screen,
            middle,
            cursor_x,
            hint,
            palette["dim"],
            max(1, x + width - cursor_x - 1),
        )
        return None

    text, text_cursor, paste_payloads = dashboard_draft(
        dashboard_state, workspace.session.session_id
    )
    cursor_x = curses_add(screen, middle, cursor_x, " › ", palette["cyan"])
    input_width = max(1, x + width - cursor_x - 1)
    visible, cursor_column = composer_display_window(
        text, text_cursor, input_width, paste_payloads
    )
    if visible:
        curses_add(
            screen,
            middle,
            cursor_x,
            visible,
            palette["dim"] if sending_here or not active else palette["normal"],
            input_width,
        )
    elif active and dashboard_state.focus == "compose" and not sending_here:
        curses_add(
            screen,
            middle,
            cursor_x,
            "Type or paste, then Enter",
            palette["dim"],
            input_width,
        )
    elif not active:
        curses_add(
            screen,
            middle,
            cursor_x,
            "Select this pane to type",
            palette["dim"],
            input_width,
        )
    if active and dashboard_state.focus == "compose" and not sending_here:
        return (middle, min(cursor_x + cursor_column, x + width - 1))
    return None


def draw_dashboard(
    screen: curses.window,
    workspaces: list[Workspace],
    dashboard_state: DashboardState,
    palette: dict[str, int],
    interval: float,
    error: str | None,
    now: float,
) -> None:
    screen.erase()
    height, width = screen.getmaxyx()
    usable_width = max(1, width - 1)
    attached_total = sum(workspace.session.attached for workspace in workspaces)
    topbar_left = " TMUXIUS" + (" | DEMO" if dashboard_state.demo_mode else "")
    topbar_right = f"LIVE  {time.strftime('%H:%M:%S')} "
    topbar_gap = max(1, usable_width - len(topbar_left) - len(topbar_right))
    topbar = truncate_display(
        f"{topbar_left}{' ' * topbar_gap}{topbar_right}", usable_width
    )
    topbar = topbar + " " * max(0, usable_width - display_width(topbar))
    try:
        screen.addstr(0, 0, topbar, palette["topbar"])
    except curses.error:
        pass

    x = 1
    x = curses_add(screen, 1, x, str(len(workspaces)), palette["bold"])
    x = curses_add(screen, 1, x, " workspaces | ", palette["dim"])
    x = curses_add(screen, 1, x, str(attached_total), palette["green"])
    view_mode = "STACKED" if dashboard_state.split_view else "ONE"
    status_suffix = (
        f" attached | {interval:g}s live | {view_mode} | INPUT"
        if usable_width < 60
        else f" attached | {interval:g}s live | {view_mode} VIEW | INTERACTIVE"
    )
    x = curses_add(
        screen,
        1,
        x,
        status_suffix,
        palette["dim"],
    )
    legend_width = 35
    legend_x = usable_width - legend_width
    if legend_x > x + 1:
        x = legend_x
        x = curses_add(screen, 1, x, "G <=10m", palette["green"])
        x = curses_add(screen, 1, x, "  Y 10-30m", palette["recent"])
        x = curses_add(screen, 1, x, "  O 30-60m", palette["orange"])
        curses_add(screen, 1, x, "  D >60m", palette["complete"])

    if error:
        draw_section_heading(screen, 3, usable_width, "TMUX UNAVAILABLE", palette)
        curses_add(
            screen,
            4,
            2,
            error,
            palette["red"],
            max(1, usable_width - 4),
        )
        screen.noutrefresh()
        curses.doupdate()
        return
    if not workspaces:
        draw_section_heading(screen, 3, usable_width, "WORKSPACES", palette)
        curses_add(
            screen,
            4,
            2,
            "No tmux workspaces to monitor.",
            palette["dim"],
            max(1, usable_width - 4),
        )
        screen.noutrefresh()
        curses.doupdate()
        return
    minimum_height = 16 if dashboard_state.split_view else 10
    if height < minimum_height or width < 52:
        curses_add(
            screen,
            3,
            1,
            (
                f"Resize to at least 52 columns and {minimum_height} rows "
                "for this dashboard."
            ),
            palette["orange"],
            max(1, usable_width - 2),
        )
        screen.noutrefresh()
        curses.doupdate()
        return

    if dashboard_state.workspaces_collapsed:
        workspace_bottom = 1
    else:
        active_session_id = dashboard_active_session_id(dashboard_state)
        selected_index = selected_workspace_index(workspaces, active_session_id)
        session_width = max(
            2,
            min(
                10,
                max(
                    display_width(truncate_display(safe_label(item.session.name), 10))
                    for item in workspaces
                ),
            ),
        )
        panel_width = usable_width
        inner_x = 1
        inner_width = max(1, panel_width - 2)
        show_working = inner_width >= 65
        table_capacity = dashboard_table_capacity(height, dashboard_state.split_view)
        table_count = min(len(workspaces), table_capacity)
        first = max(
            0,
            min(
                selected_index - table_count // 2,
                max(0, len(workspaces) - table_count),
            ),
        )
        shown = workspaces[first : first + table_count]
        workspace_top = 2
        header_y = workspace_top + 1
        row_start = header_y + 1
        workspace_bottom = row_start + len(shown) - 1
        draw_section_heading(
            screen,
            workspace_top,
            panel_width,
            f"WORKSPACES {len(workspaces)} / {attached_total} ATTACHED",
            palette,
        )
        x = inner_x
        x = curses_add(screen, header_y, x, "  ", palette["dim"], 2)
        x = curses_add(
            screen,
            header_y,
            x,
            display_field("ID", session_width, align_right=True),
            palette["dim"],
            session_width,
        )
        x = curses_add(
            screen,
            header_y,
            x,
            "  ATT  AGENT    STATUS     LAST     ",
            palette["dim"],
        )
        if show_working:
            x = curses_add(screen, header_y, x, "RUN      ", palette["dim"])
        curses_add(screen, header_y, x, "SUBJECT", palette["dim"])

        for row_offset, workspace in enumerate(shown):
            y = row_start + row_offset
            selected_slots = [
                slot
                for slot, session_id in enumerate(
                    dashboard_state.selected_session_ids[
                        : dashboard_slot_count(dashboard_state)
                    ]
                )
                if workspace.session.session_id == session_id
            ]
            selected = bool(selected_slots)
            active_selected = workspace.session.session_id == active_session_id
            tier = activity_tier(workspace.last_activity, workspace.state, now)
            tier_attribute = palette.get(tier, palette["dim"])
            x = inner_x
            x = curses_add(
                screen,
                y,
                x,
                (
                    "> "
                    if active_selected
                    else ("T " if selected_slots == [0] else "B ")
                    if selected
                    else "  "
                ),
                palette["selected"] if selected else palette["dim"],
                2,
            )
            name = display_field(
                safe_label(workspace.session.name), session_width, align_right=True
            )
            x = curses_add(
                screen,
                y,
                x,
                name,
                palette["selected"] if selected else palette["cyan"],
                session_width,
            )
            marker = "yes" if workspace.session.attached else "--"
            x = curses_add(screen, y, x, "  ", palette["normal"], 2)
            x = curses_add(
                screen,
                y,
                x,
                marker,
                palette["green"] if workspace.session.attached else palette["dim"],
                3,
            )
            x = curses_add(screen, y, x, "  ", palette["normal"], 2)
            x = curses_add(
                screen,
                y,
                x,
                display_field(workspace.app, 7),
                palette["normal"],
                7,
            )
            x = curses_add(screen, y, x, "  ", palette["normal"], 2)
            state_field = display_field(
                lifecycle_label(workspace.state, tier).upper(), 9
            )
            if tier == "busy":
                x = curses_add_busy(screen, y, x, state_field, palette, 9)
            else:
                x = curses_add(screen, y, x, state_field, tier_attribute, 9)
            x = curses_add(screen, y, x, "  ", palette["normal"], 2)
            age = display_field(format_activity_age(workspace.last_activity, now), 7)
            age_attribute = palette["busy_0"] if tier == "busy" else tier_attribute
            x = curses_add(screen, y, x, age, age_attribute, 7)
            x = curses_add(screen, y, x, "  ", palette["normal"], 2)
            if show_working:
                duration = (
                    format_elapsed(workspace.busy_seconds)
                    if workspace.state == "busy"
                    else "-"
                )
                x = curses_add(
                    screen,
                    y,
                    x,
                    display_field(duration, 7),
                    palette["busy_3"]
                    if workspace.state == "busy"
                    else palette["dim"],
                    7,
                )
                x = curses_add(screen, y, x, "  ", palette["normal"], 2)
            title_attribute = palette["bold"] if active_selected else palette["normal"]
            curses_add(
                screen,
                y,
                x,
                workspace_subject(workspace),
                title_attribute,
                max(1, panel_width - x - 2),
            )

    cursor_position: tuple[int, int] | None = None
    workspace_by_id = {
        workspace.session.session_id: workspace for workspace in workspaces
    }
    geometries = dashboard_panel_geometries(
        usable_width,
        height,
        workspace_bottom,
        dashboard_state.split_view,
        dashboard_state.active_slot,
    )
    labels = ("TOP", "BOTTOM") if dashboard_state.split_view else ("LIVE CHAT",)
    for slot, geometry in enumerate(geometries):
        session_id = dashboard_state.selected_session_ids[slot]
        workspace = workspace_by_id.get(session_id or "")
        if workspace is None:
            continue
        active = slot == dashboard_state.active_slot
        draw_chat_panel(
            screen,
            workspace,
            dashboard_state,
            palette,
            now,
            x=geometry.x,
            width=geometry.width,
            top=geometry.chat_top,
            bottom=geometry.chat_bottom,
            label=labels[slot],
            active=active,
        )
        if active:
            panel_cursor = draw_composer_panel(
                screen,
                workspace,
                dashboard_state,
                palette,
                x=geometry.x,
                width=geometry.width,
                middle=geometry.composer_middle,
                label=labels[slot],
                active=True,
            )
            if panel_cursor is not None:
                cursor_position = panel_cursor

    footer_y = height - 1
    if dashboard_state.status:
        footer_text = dashboard_state.status
        footer_attribute = palette.get(dashboard_state.status_kind, palette["dim"])
    elif dashboard_state.focus == "window" and dashboard_state.split_view:
        footer_text = (
            "WINDOW  |  c workspaces  |  Up/Down/Scroll top/bottom  |  Right Select ID  |  "
            "Tab toggle  |  s one  |  q quit"
        )
        footer_attribute = palette["selected"]
    elif dashboard_state.focus == "nav" and dashboard_state.split_view:
        footer_text = (
            "SELECT ID  |  c workspaces  |  Left Window  |  Up/Down/Scroll workspace  |  "
            "number ID  |  Right Message  |  s one"
        )
        footer_attribute = palette["busy_0"]
    elif dashboard_state.focus == "nav":
        footer_text = (
            "SELECT ID  |  c workspaces  |  Up/Down/Scroll workspace  |  number ID  |  "
            "Right Message  |  s stacked  |  q quit"
        )
        footer_attribute = palette["busy_0"]
    else:
        footer_text = (
            "MESSAGE  |  Enter send/steer  |  Left at start Select ID  |  "
            "Up/Down/Scroll chat"
        )
        if dashboard_state.split_view:
            footer_text += "  |  Tab top/bottom"
        else:
            footer_text += "  |  Esc IDs"
        footer_attribute = palette["dim"]
    curses_add(
        screen,
        footer_y,
        1,
        footer_text,
        footer_attribute,
        max(1, usable_width - 2),
    )
    try:
        curses.curs_set(1 if cursor_position else 0)
        if cursor_position:
            screen.move(*cursor_position)
    except curses.error:
        pass
    screen.noutrefresh()
    curses.doupdate()


def set_dashboard_status(
    state: DashboardState,
    text: str,
    kind: str = "dim",
    duration: float = 5.0,
) -> None:
    state.status = text
    state.status_kind = kind
    state.status_until = time.monotonic() + duration


def locate_tmux_communication_helper() -> Path:
    script_path = Path(__file__).resolve()
    candidates = [
        script_path.parent / "lib/tmux_communication.py",
        script_path.parent.parent / "share/tmuxius/tmux_communication.py",
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    raise FileNotFoundError("verified tmux communication helper is unavailable")


def send_failure_detail(stdout: str, stderr: str) -> str:
    lines = [clean_text(line) for line in f"{stderr}\n{stdout}".splitlines()]
    lines = [line for line in lines if line]
    for line in reversed(lines):
        lowered = line.casefold()
        if any(
            phrase in lowered
            for phrase in (
                "refusing to send-user",
                "composer changed",
                "submission unverified",
                "outbound payload",
                "tmux buffer differs",
            )
        ):
            return truncate_display(line, 120)
    return "verified submission failed; inspect the live chat before retrying"


def submit_dashboard_message(
    socket: str | None,
    workspace: Workspace,
    message: str,
    results: queue.Queue[SendResult],
) -> None:
    try:
        helper = locate_tmux_communication_helper()
        resolved_socket = socket or run_tmux(
            None,
            "display-message",
            "-p",
            "-t",
            workspace.pane_id,
            "#{socket_path}",
        ).strip()
        if not resolved_socket:
            raise TmuxError("tmux socket path could not be resolved")
        result = subprocess.run(
            [
                sys.executable,
                str(helper),
                "--socket",
                resolved_socket,
                "--target",
                workspace.pane_id,
                "send-user",
                "--lines",
                "40",
            ],
            input=message,
            text=True,
            capture_output=True,
            check=False,
            timeout=20,
        )
        if result.returncode == 0 and "USER_MESSAGE_SUBMITTED" in result.stdout:
            results.put(
                SendResult(True, workspace.session.session_id, "exact message submitted")
            )
            return
        results.put(
            SendResult(
                False,
                workspace.session.session_id,
                send_failure_detail(result.stdout, result.stderr),
            )
        )
    except subprocess.TimeoutExpired:
        results.put(
            SendResult(
                False,
                workspace.session.session_id,
                "submission proof timed out; inspect chat before retrying",
            )
        )
    except (OSError, TmuxError, FileNotFoundError) as exc:
        results.put(
            SendResult(
                False,
                workspace.session.session_id,
                truncate_display(clean_text(str(exc)) or "submission failed", 120),
            )
        )


def move_workspace_selection(
    workspaces: list[Workspace], selected_session_id: str | None, delta: int
) -> str | None:
    if not workspaces:
        return None
    index = selected_workspace_index(workspaces, selected_session_id)
    return workspaces[(index + delta) % len(workspaces)].session.session_id


def activate_workspace_input(
    state: DashboardState, session_id: str | None
) -> None:
    previous = state.active_draft_session
    if previous is not None:
        state.drafts[previous] = state.text
        state.draft_cursors[previous] = state.cursor
        state.draft_paste_payloads[previous] = dict(state.paste_payloads)
    state.active_draft_session = session_id
    if session_id is None:
        state.text = ""
        state.cursor = 0
        state.paste_payloads = {}
        return
    state.text = state.drafts.get(session_id, "")
    state.cursor = min(
        len(state.text), state.draft_cursors.get(session_id, len(state.text))
    )
    state.paste_payloads = dict(state.draft_paste_payloads.get(session_id, {}))


def read_bracketed_paste(screen: curses.window) -> PasteReadResult | None:
    """Read one complete bracketed paste after its leading Escape was consumed."""
    start = "[200~"
    end = "\x1b[201~"
    prefix: list[object] = []
    try:
        screen.timeout(400)
        for expected in start:
            received = screen.get_wch()
            prefix.append(received)
            if received != expected:
                for key in reversed(prefix):
                    replay_curses_key(key)
                return None
        screen.timeout(250)
        collected: list[str] = []
        tail = ""
        too_large = False
        complete = False
        idle_deadline = time.monotonic() + BRACKETED_PASTE_IDLE_SECONDS
        while True:
            try:
                received = screen.get_wch()
            except curses.error:
                if time.monotonic() >= idle_deadline:
                    break
                continue
            if not isinstance(received, str):
                continue
            idle_deadline = time.monotonic() + BRACKETED_PASTE_IDLE_SECONDS
            if not too_large:
                collected.append(received)
                if len(collected) > MAX_MESSAGE_CHARS + len(end):
                    too_large = True
                    collected.clear()
            tail = (tail + received)[-len(end) :]
            if tail == end:
                complete = True
                break
        if not complete:
            return PasteReadResult("", complete=False, too_large=too_large)
        if too_large:
            return PasteReadResult("", too_large=True)
        raw = "".join(collected)
        if raw.endswith(end):
            raw = raw[: -len(end)]
        cleaned = sanitize_composer_input(raw)
        return PasteReadResult(
            cleaned,
            too_large=len(cleaned) > MAX_MESSAGE_CHARS,
        )
    except curses.error:
        for key in reversed(prefix):
            replay_curses_key(key)
        return None
    finally:
        screen.timeout(100)


def paste_burst_character(key: object) -> str | None:
    if not isinstance(key, str) or len(key) != 1:
        return None
    if key in {"\n", "\r"}:
        return "\n"
    if key == "\t" or key.isprintable():
        return key
    return None


def replay_curses_key(key: object) -> None:
    try:
        if isinstance(key, str):
            curses.unget_wch(key)
        elif isinstance(key, int):
            curses.ungetch(key)
    except curses.error:
        pass


def read_unbracketed_paste_burst(
    screen: curses.window, first_key: object
) -> PasteReadResult | None:
    """Collapse a rapid non-bracketed key burst before Enter can submit it."""
    first = paste_burst_character(first_key)
    if first is None or first == "\n":
        return None
    try:
        screen.timeout(max(1, round(PASTE_BURST_CHAR_INTERVAL_SECONDS * 1000)))
        try:
            second_key = screen.get_wch()
        except curses.error:
            return None
        second = paste_burst_character(second_key)
        if second is None:
            replay_curses_key(second_key)
            return None

        collected = [first, second]
        too_large = len(collected) > MAX_MESSAGE_CHARS
        screen.timeout(max(1, round(PASTE_BURST_IDLE_SECONDS * 1000)))
        while True:
            try:
                key = screen.get_wch()
            except curses.error:
                break
            character = paste_burst_character(key)
            if character is None:
                replay_curses_key(key)
                break
            if not too_large:
                collected.append(character)
                if len(collected) > MAX_MESSAGE_CHARS:
                    too_large = True
                    collected.clear()
        if too_large:
            return PasteReadResult("", too_large=True)
        return PasteReadResult(sanitize_composer_input("".join(collected)))
    finally:
        screen.timeout(100)


def run_dashboard(
    socket: str | None,
    history_lines: int,
    interval: float,
    color_enabled: bool,
) -> int:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("tmuxius requires an interactive terminal", file=sys.stderr)
        return 2

    def dashboard_loop(screen: curses.window) -> int:
        try:
            curses.raw()
        except curses.error:
            pass
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        screen.keypad(True)
        screen.timeout(100)
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
            curses.mouseinterval(0)
        except curses.error:
            pass
        try:
            os.write(sys.stdout.fileno(), b"\x1b[?2004h")
        except OSError:
            pass
        palette = initialize_curses_palette(color_enabled)
        workspaces: list[Workspace] = []
        error: str | None = None
        dashboard_state = DashboardState()
        send_results: queue.Queue[SendResult] = queue.Queue()
        next_selected_refresh = 0.0
        next_background_refresh = 0.0
        next_detail_refresh = 0.0
        panes_by_session: dict[str, Pane] = {}
        monitor_visible = True
        draw_needed = True
        # Pane IDs are local to a server; another socket may also have %0.
        current_socket = os.environ.get("TMUX", "").rsplit(",", 2)[0]
        current_pane = (
            os.environ.get("TMUX_PANE")
            if current_socket and (socket is None or
                                   Path(socket).resolve() == Path(current_socket).resolve())
            else None
        )

        def active_session_id() -> str | None:
            return dashboard_active_session_id(dashboard_state)

        def displayed_session_ids() -> tuple[str, ...]:
            return dashboard_displayed_session_ids(dashboard_state)

        def switch_selection(
            session_id: str | None,
            announce: bool = False,
            slot: int | None = None,
        ) -> None:
            nonlocal draw_needed, next_selected_refresh
            target_slot = dashboard_state.active_slot if slot is None else slot
            target_slot = max(0, min(1, target_slot))
            current = dashboard_state.selected_session_ids[target_slot]
            if session_id == current:
                dashboard_state.selector = ""
                return
            if dashboard_state.split_view and session_id is not None:
                other_slot = 1 - target_slot
                if dashboard_state.selected_session_ids[other_slot] == session_id:
                    dashboard_state.selected_session_ids[other_slot] = current
            dashboard_state.selected_session_ids[target_slot] = session_id
            if target_slot == dashboard_state.active_slot:
                activate_workspace_input(dashboard_state, session_id)
            next_selected_refresh = 0.0
            dashboard_state.selector = ""
            if announce and session_id is not None:
                selected = next(
                    (
                        item
                        for item in workspaces
                        if item.session.session_id == session_id
                    ),
                    None,
                )
                if selected:
                    pane_label = (
                        "TOP"
                        if dashboard_state.split_view and target_slot == 0
                        else "BOTTOM"
                        if dashboard_state.split_view
                        else "WORKSPACE"
                    )
                    set_dashboard_status(
                        dashboard_state,
                        f"SELECTED {pane_label} {safe_label(selected.session.name)}",
                        "busy_0",
                        2.0,
                    )
            draw_needed = True

        def switch_active_slot(slot: int, announce: bool = False) -> None:
            nonlocal draw_needed, next_selected_refresh
            target = 0 if not dashboard_state.split_view else max(0, min(1, slot))
            if target == dashboard_state.active_slot:
                return
            dashboard_state.active_slot = target
            activate_workspace_input(
                dashboard_state, dashboard_state.selected_session_ids[target]
            )
            dashboard_state.selector = ""
            next_selected_refresh = 0.0
            if announce:
                set_dashboard_status(
                    dashboard_state,
                    f"ACTIVE {'TOP' if target == 0 else 'BOTTOM'} PANE",
                    "busy_0",
                    2.0,
                )
            draw_needed = True

        def toggle_split_view() -> None:
            nonlocal draw_needed, next_selected_refresh
            if not dashboard_state.split_view:
                terminal_height, _ = screen.getmaxyx()
                if terminal_height < 16:
                    set_dashboard_status(
                        dashboard_state,
                        "STACKED VIEW NEEDS AT LEAST 16 TERMINAL ROWS",
                        "orange",
                        4.0,
                    )
                    draw_needed = True
                    return
                if len(workspaces) < 2:
                    set_dashboard_status(
                        dashboard_state,
                        "STACKED VIEW NEEDS TWO WORKSPACES",
                        "orange",
                        3.0,
                    )
                    draw_needed = True
                    return
                primary = dashboard_state.selected_session_ids[0]
                secondary = dashboard_state.selected_session_ids[1]
                available = [
                    item.session.session_id
                    for item in workspaces
                    if item.session.session_id != primary
                ]
                if secondary not in available:
                    secondary = move_workspace_selection(
                        workspaces, primary, 1
                    )
                    if secondary == primary:
                        secondary = available[0]
                dashboard_state.selected_session_ids[1] = secondary
                dashboard_state.split_view = True
                dashboard_state.active_slot = 0
                activate_workspace_input(dashboard_state, primary)
                set_dashboard_status(
                    dashboard_state,
                    "STACKED VIEW — TOP PANE ACTIVE",
                    "busy_0",
                    3.0,
                )
            else:
                if dashboard_state.active_slot == 1:
                    (
                        dashboard_state.selected_session_ids[0],
                        dashboard_state.selected_session_ids[1],
                    ) = (
                        dashboard_state.selected_session_ids[1],
                        dashboard_state.selected_session_ids[0],
                    )
                dashboard_state.split_view = False
                dashboard_state.active_slot = 0
                if dashboard_state.focus == "window":
                    dashboard_state.focus = "nav"
                activate_workspace_input(
                    dashboard_state, dashboard_state.selected_session_ids[0]
                )
                set_dashboard_status(
                    dashboard_state,
                    "ONE-PANEL VIEW",
                    "busy_0",
                    3.0,
                )
            dashboard_state.selector = ""
            next_selected_refresh = 0.0
            draw_needed = True

        def reconcile_selections() -> None:
            nonlocal next_selected_refresh
            before = (
                dashboard_state.split_view,
                dashboard_state.active_slot,
                tuple(dashboard_state.selected_session_ids),
                dashboard_state.active_draft_session,
            )
            available = [item.session.session_id for item in workspaces]
            if not available:
                dashboard_state.split_view = False
                dashboard_state.active_slot = 0
                if dashboard_state.focus == "window":
                    dashboard_state.focus = "nav"
                dashboard_state.selected_session_ids[:] = [None, None]
                if dashboard_state.active_draft_session is not None:
                    activate_workspace_input(dashboard_state, None)
                if before != (
                    dashboard_state.split_view,
                    dashboard_state.active_slot,
                    tuple(dashboard_state.selected_session_ids),
                    dashboard_state.active_draft_session,
                ):
                    next_selected_refresh = 0.0
                return
            if dashboard_state.split_view and len(available) < 2:
                dashboard_state.split_view = False
                dashboard_state.active_slot = 0
                if dashboard_state.focus == "window":
                    dashboard_state.focus = "nav"
            primary = dashboard_state.selected_session_ids[0]
            if primary not in available:
                primary = default_workspace_session_id(workspaces) or available[0]
                dashboard_state.selected_session_ids[0] = primary
            secondary = dashboard_state.selected_session_ids[1]
            if secondary not in available or secondary == primary:
                dashboard_state.selected_session_ids[1] = next(
                    (candidate for candidate in available if candidate != primary),
                    primary,
                )
            if not dashboard_state.split_view:
                dashboard_state.active_slot = 0
                if dashboard_state.focus == "window":
                    dashboard_state.focus = "nav"
            active = active_session_id()
            if dashboard_state.active_draft_session != active:
                activate_workspace_input(dashboard_state, active)
            after = (
                dashboard_state.split_view,
                dashboard_state.active_slot,
                tuple(dashboard_state.selected_session_ids),
                dashboard_state.active_draft_session,
            )
            if before != after:
                next_selected_refresh = 0.0

        def commit_selector(force: bool = False) -> None:
            nonlocal draw_needed
            selector = dashboard_state.selector
            if not selector:
                return
            numeric = [item for item in workspaces if item.session.name.isdecimal()]
            matches = [item for item in numeric if item.session.name.startswith(selector)]
            exact = next((item for item in matches if item.session.name == selector), None)
            longer = any(item.session.name != selector for item in matches)
            if exact and (force or not longer):
                switch_selection(exact.session.session_id, announce=True)
                return
            if not matches or force:
                set_dashboard_status(
                    dashboard_state,
                    f"NO WORKSPACE ID {selector}",
                    "red",
                    3.0,
                )
                dashboard_state.selector = ""
                draw_needed = True

        def scroll_context(delta: int) -> None:
            nonlocal draw_needed
            selected_session_id = active_session_id()
            if selected_session_id is None:
                return
            context = dashboard_vertical_context(
                dashboard_state.focus, dashboard_state.split_view
            )
            if context == "window":
                switch_active_slot(0 if delta > 0 else 1, announce=True)
            elif context == "workspace":
                switch_selection(
                    move_workspace_selection(
                        workspaces, selected_session_id, -1 if delta > 0 else 1
                    ),
                    announce=True,
                )
            else:
                current = dashboard_state.preview_scroll.get(selected_session_id, 0)
                dashboard_state.preview_scroll[selected_session_id] = max(
                    0, current + delta
                )
                draw_needed = True

        def apply_dashboard_paste(paste: PasteReadResult) -> None:
            nonlocal draw_needed
            if not paste.complete:
                dashboard_state.focus = "nav"
                dashboard_state.selector = ""
                set_dashboard_status(
                    dashboard_state,
                    "PASTE DID NOT CLOSE — NOTHING ADDED — PRESS RIGHT TO RESUME",
                    "red",
                    8.0,
                )
            elif paste.too_large:
                set_dashboard_status(
                    dashboard_state,
                    (
                        "PASTE TOO LARGE — 1,048,576 CHARACTER MAX — "
                        "NOTHING ADDED"
                    ),
                    "red",
                    8.0,
                )
            elif not paste.text:
                set_dashboard_status(
                    dashboard_state,
                    "PASTE WAS EMPTY — NOTHING ADDED",
                    "orange",
                    4.0,
                )
            elif dashboard_state.focus != "compose":
                set_dashboard_status(
                    dashboard_state,
                    "PASTE IGNORED IN CONTROL MODE — SELECT MESSAGE",
                    "orange",
                    4.0,
                )
            elif dashboard_state.sending:
                set_dashboard_status(
                    dashboard_state,
                    "WAIT FOR THE CURRENT SUBMISSION TO FINISH",
                    "orange",
                    4.0,
                )
            elif not insert_composer_text(
                dashboard_state, paste.text, pasted=True
            ):
                set_dashboard_status(
                    dashboard_state,
                    (
                        "MESSAGE WOULD EXCEED 1,048,576 CHARACTERS — "
                        "PASTE NOT ADDED"
                    ),
                    "orange",
                    6.0,
                )
            elif len(paste.text) > LARGE_PASTE_CHAR_THRESHOLD:
                set_dashboard_status(
                    dashboard_state,
                    (
                        f"PASTED {len(paste.text):,} CHARS AS ONE CONTENT BLOCK — "
                        "ENTER TO SEND"
                    ),
                    "green",
                    5.0,
                )
            draw_needed = True

        try:
            while True:
                monotonic_now = time.monotonic()
                if (
                    dashboard_state.status
                    and not dashboard_state.sending
                    and monotonic_now >= dashboard_state.status_until
                ):
                    dashboard_state.status = ""
                    draw_needed = True

                while True:
                    try:
                        send_result = send_results.get_nowait()
                    except queue.Empty:
                        break
                    dashboard_state.sending = False
                    if send_result.ok:
                        dashboard_state.drafts[send_result.session_id] = ""
                        dashboard_state.draft_cursors[send_result.session_id] = 0
                        dashboard_state.draft_paste_payloads[send_result.session_id] = {}
                        if dashboard_state.active_draft_session == send_result.session_id:
                            dashboard_state.text = ""
                            dashboard_state.cursor = 0
                            dashboard_state.paste_payloads = {}
                        dashboard_state.preview_scroll[send_result.session_id] = 0
                        set_dashboard_status(
                            dashboard_state,
                            "MESSAGE SUBMITTED EXACTLY — WATCHING FOR RESPONSE",
                            "green",
                            6.0,
                        )
                        next_selected_refresh = 0.0
                        next_background_refresh = 0.0
                    else:
                        if (
                            dashboard_state.inflight_session
                            == send_result.session_id
                            and dashboard_state.inflight_message
                        ):
                            restored = dashboard_state.inflight_draft
                            restored_payloads = dict(
                                dashboard_state.inflight_paste_payloads
                            )
                            dashboard_state.drafts[send_result.session_id] = restored
                            dashboard_state.draft_cursors[send_result.session_id] = len(
                                restored
                            )
                            dashboard_state.draft_paste_payloads[
                                send_result.session_id
                            ] = restored_payloads
                            if (
                                dashboard_state.active_draft_session
                                == send_result.session_id
                            ):
                                dashboard_state.text = restored
                                dashboard_state.cursor = len(restored)
                                dashboard_state.paste_payloads = restored_payloads
                        set_dashboard_status(
                            dashboard_state,
                            f"SEND STOPPED — DRAFT RESTORED — {send_result.detail}",
                            "red",
                            10.0,
                        )
                    dashboard_state.inflight_session = None
                    dashboard_state.inflight_message = ""
                    dashboard_state.inflight_draft = ""
                    dashboard_state.inflight_paste_payloads = {}
                    draw_needed = True

                if (
                    dashboard_state.focus == "nav"
                    and dashboard_state.selector
                    and monotonic_now - dashboard_state.selector_updated >= 0.7
                ):
                    commit_selector(force=True)

                if monotonic_now >= next_background_refresh:
                    try:
                        sessions = list_sessions(socket)
                        live_panes = list_active_panes(socket)
                        dashboard_session = next(
                            (
                                session
                                for session in sessions
                                if live_panes.get(session.session_id) is not None
                                and live_panes[session.session_id].pane_id
                                == current_pane
                            ),
                            None,
                        )
                        monitor_visible = (
                            dashboard_session is None
                            or dashboard_session.attached > 0
                        )
                        visible_sessions = [
                            session
                            for session in sessions
                            if live_panes.get(session.session_id) is None
                            or live_panes[session.session_id].pane_id != current_pane
                        ]
                        live_identity = tuple(
                            (
                                session.session_id,
                                session.name,
                                live_panes.get(session.session_id).pane_id
                                if live_panes.get(session.session_id)
                                else "",
                            )
                            for session in visible_sessions
                        )
                        cached_identity = tuple(
                            (
                                workspace.session.session_id,
                                workspace.session.name,
                                workspace.pane_id,
                            )
                            for workspace in workspaces
                        )
                        if monitor_visible and live_identity != cached_identity:
                            workspaces = collect_workspaces(
                                sessions,
                                socket,
                                history_lines,
                                exclude_pane_id=current_pane,
                            )
                            next_detail_refresh = (
                                time.monotonic() + DETAIL_REFRESH_SECONDS
                            )
                        elif monitor_visible:
                            displayed = set(displayed_session_ids())
                            sessions_by_id = {
                                session.session_id: session
                                for session in visible_sessions
                            }
                            background_panes = [
                                live_panes[workspace.session.session_id]
                                for workspace in workspaces
                                if workspace.session.session_id not in displayed
                                and workspace.session.session_id in live_panes
                            ]
                            snapshots = capture_snapshots(
                                socket,
                                background_panes,
                                BACKGROUND_HISTORY_LINES,
                            )
                            wall_now = time.time()
                            refreshed: list[Workspace] = []
                            for workspace in workspaces:
                                session = sessions_by_id.get(
                                    workspace.session.session_id,
                                    workspace.session,
                                )
                                pane = live_panes.get(session.session_id)
                                snapshot = (
                                    snapshots.get(pane.pane_id)
                                    if pane is not None
                                    else None
                                )
                                if (
                                    session.session_id not in displayed
                                    and snapshot is not None
                                ):
                                    updated = refresh_workspace_from_snapshot(
                                        workspace,
                                        session,
                                        snapshot,
                                        now=wall_now,
                                        include_preview=False,
                                    )
                                    refreshed.append(
                                        replace(
                                            updated,
                                            window_title=(
                                                explicit_window_subject(pane)
                                                if pane is not None
                                                else None
                                            ),
                                        )
                                    )
                                else:
                                    refreshed.append(
                                        replace(
                                            workspace,
                                            session=session,
                                            pane_id=(
                                                pane.pane_id
                                                if pane is not None
                                                else workspace.pane_id
                                            ),
                                            window_title=(
                                                explicit_window_subject(pane)
                                                if pane is not None
                                                else None
                                            ),
                                        )
                                    )
                            workspaces = refreshed
                        panes_by_session = live_panes
                        error = None
                    except TmuxError as exc:
                        if not workspaces:
                            error = clean_text(str(exc)) or "unknown tmux error"
                    reconcile_selections()
                    next_background_refresh = (
                        time.monotonic()
                        + (
                            BACKGROUND_REFRESH_SECONDS
                            if monitor_visible
                            else 2.0
                        )
                    )
                    if monitor_visible:
                        draw_needed = True

                if (
                    monitor_visible
                    and workspaces
                    and panes_by_session
                    and monotonic_now >= next_detail_refresh
                ):
                    workspaces = refresh_workspace_details(
                        workspaces, panes_by_session, socket
                    )
                    next_detail_refresh = (
                        time.monotonic() + DETAIL_REFRESH_SECONDS
                    )
                    draw_needed = True

                if (
                    monitor_visible
                    and workspaces
                    and displayed_session_ids()
                    and monotonic_now >= next_selected_refresh
                ):
                    selected_panes = [
                        panes_by_session[session_id]
                        for session_id in displayed_session_ids()
                        if session_id in panes_by_session
                    ]
                    try:
                        selected_snapshots = capture_snapshots(
                            socket, selected_panes, history_lines
                        )
                        wall_now = time.time()
                        displayed = set(displayed_session_ids())
                        refreshed: list[Workspace] = []
                        for workspace in workspaces:
                            if workspace.session.session_id not in displayed:
                                refreshed.append(workspace)
                                continue
                            pane = panes_by_session.get(
                                workspace.session.session_id
                            )
                            snapshot = (
                                selected_snapshots.get(pane.pane_id)
                                if pane is not None
                                else None
                            )
                            if snapshot is None:
                                refreshed.append(workspace)
                                continue
                            refreshed.append(
                                refresh_workspace_from_snapshot(
                                    workspace,
                                    workspace.session,
                                    snapshot,
                                    now=wall_now,
                                    include_preview=True,
                                )
                            )
                        workspaces = refreshed
                    except TmuxError:
                        # Keep the last good frames. The topology pass handles
                        # closed or replaced panes without a refresh spin.
                        pass
                    next_selected_refresh = time.monotonic() + interval
                    draw_needed = True

                if draw_needed and monitor_visible:
                    draw_dashboard(
                        screen,
                        workspaces,
                        dashboard_state,
                        palette,
                        interval,
                        error,
                        time.time(),
                    )
                    draw_needed = False

                try:
                    key = screen.get_wch()
                except curses.error:
                    continue

                if key == curses.KEY_RESIZE:
                    draw_needed = True
                    continue

                if key == curses.KEY_MOUSE:
                    try:
                        _, mouse_x, mouse_y, _, button_state = curses.getmouse()
                    except curses.error:
                        continue
                    terminal_height, terminal_width = screen.getmaxyx()
                    usable_width = max(1, terminal_width - 1)
                    workspace_bottom = dashboard_workspace_bottom(
                        terminal_height,
                        len(workspaces),
                        dashboard_state.split_view,
                        dashboard_state.workspaces_collapsed,
                    )
                    geometries = dashboard_panel_geometries(
                        usable_width,
                        terminal_height,
                        workspace_bottom,
                        dashboard_state.split_view,
                        dashboard_state.active_slot,
                    )
                    mouse_slot = next(
                        (
                            slot
                            for slot, geometry in enumerate(geometries)
                            if geometry.x <= mouse_x < geometry.x + geometry.width
                            and geometry.chat_top
                            <= mouse_y
                            <= max(geometry.chat_bottom, geometry.composer_bottom)
                        ),
                        dashboard_state.active_slot,
                    )
                    if (
                        dashboard_state.split_view
                        and mouse_y > workspace_bottom
                    ):
                        switch_active_slot(mouse_slot)
                    if button_state & curses.BUTTON4_PRESSED:
                        scroll_context(3)
                    elif button_state & curses.BUTTON5_PRESSED:
                        scroll_context(-3)
                    elif button_state & curses.BUTTON1_CLICKED:
                        active_geometry = geometries[dashboard_state.active_slot]
                        if (
                            active_geometry.composer_top
                            <= mouse_y
                            <= active_geometry.composer_bottom
                        ):
                            clicked_focus = (
                                dashboard_focus_at_x(
                                    active_geometry.x,
                                    dashboard_state.split_view,
                                    mouse_x,
                                )
                                if mouse_y == active_geometry.composer_middle
                                else None
                            )
                            dashboard_state.focus = clicked_focus or "compose"
                            dashboard_state.selector = ""
                            draw_needed = True
                        elif (
                            active_geometry.chat_top
                            <= mouse_y
                            <= active_geometry.chat_bottom
                        ):
                            dashboard_state.focus = "nav"
                            dashboard_state.selector = ""
                            draw_needed = True
                    continue

                if key == "\x1b":
                    pasted = read_bracketed_paste(screen)
                    if pasted is not None:
                        dashboard_state.paste_enter_suppress_until = 0.0
                        apply_dashboard_paste(pasted)
                        continue
                    dashboard_state.focus = "nav"
                    dashboard_state.selector = ""
                    draw_needed = True
                    continue

                if not workspaces:
                    continue

                if dashboard_state.sending:
                    continue

                burst = read_unbracketed_paste_burst(screen, key)
                if burst is not None:
                    dashboard_state.paste_enter_suppress_until = (
                        time.monotonic() + PASTE_ENTER_SUPPRESS_SECONDS
                    )
                    apply_dashboard_paste(burst)
                    continue

                if dashboard_state.focus in {"window", "nav"}:
                    if key in ("\t", curses.KEY_BTAB) and dashboard_state.split_view:
                        switch_active_slot(1 - dashboard_state.active_slot, announce=True)
                    elif key in (curses.KEY_RIGHT, "\t", curses.KEY_BTAB):
                        dashboard_state.focus = dashboard_focus_step(
                            dashboard_state.focus,
                            dashboard_state.split_view,
                            1,
                        )
                        dashboard_state.selector = ""
                        draw_needed = True
                    elif key == curses.KEY_LEFT:
                        dashboard_state.focus = dashboard_focus_step(
                            dashboard_state.focus,
                            dashboard_state.split_view,
                            -1,
                        )
                        dashboard_state.selector = ""
                        draw_needed = True
                    elif key == curses.KEY_UP:
                        scroll_context(3)
                    elif key == curses.KEY_DOWN:
                        scroll_context(-3)
                    elif key in ("q", "Q"):
                        return 0
                    elif key in ("s", "S"):
                        toggle_split_view()
                    elif key in ("c", "C"):
                        dashboard_state.workspaces_collapsed = (
                            not dashboard_state.workspaces_collapsed
                        )
                        draw_needed = True
                    elif key in ("r", "R", "\x0c"):
                        next_selected_refresh = 0.0
                        next_background_refresh = 0.0
                        next_detail_refresh = 0.0
                    elif (
                        dashboard_state.focus == "nav"
                        and key in ("\n", "\r", curses.KEY_ENTER)
                    ):
                        if dashboard_state.selector:
                            commit_selector(force=True)
                        else:
                            dashboard_state.focus = "compose"
                            draw_needed = True
                    elif (
                        dashboard_state.focus == "nav"
                        and key in (curses.KEY_BACKSPACE, "\x7f", "\b")
                    ):
                        dashboard_state.selector = dashboard_state.selector[:-1]
                        dashboard_state.selector_updated = time.monotonic()
                        draw_needed = True
                    elif (
                        dashboard_state.focus == "nav"
                        and isinstance(key, str)
                        and key.isdecimal()
                    ):
                        dashboard_state.selector = (
                            dashboard_state.selector + key
                        )[-12:]
                        dashboard_state.selector_updated = time.monotonic()
                        commit_selector(force=False)
                        draw_needed = True
                    continue

                if key in ("\t", curses.KEY_BTAB):
                    if dashboard_state.split_view:
                        switch_active_slot(1 - dashboard_state.active_slot, announce=True)
                    else:
                        dashboard_state.focus = "nav"
                        dashboard_state.selector = ""
                        draw_needed = True
                elif key == curses.KEY_LEFT:
                    if dashboard_state.cursor > 0:
                        dashboard_state.cursor -= 1
                    else:
                        dashboard_state.focus = dashboard_focus_step(
                            dashboard_state.focus,
                            dashboard_state.split_view,
                            -1,
                        )
                        dashboard_state.selector = ""
                    draw_needed = True
                elif key == curses.KEY_RIGHT:
                    dashboard_state.cursor = min(
                        len(dashboard_state.text), dashboard_state.cursor + 1
                    )
                    draw_needed = True
                elif key == curses.KEY_HOME or key == "\x01":
                    dashboard_state.cursor = 0
                    draw_needed = True
                elif key == curses.KEY_END or key == "\x05":
                    dashboard_state.cursor = len(dashboard_state.text)
                    draw_needed = True
                elif key == curses.KEY_UP:
                    scroll_context(3)
                elif key == curses.KEY_DOWN:
                    scroll_context(-3)
                elif key == curses.KEY_PPAGE:
                    scroll_context(10)
                elif key == curses.KEY_NPAGE:
                    scroll_context(-10)
                elif key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    if dashboard_state.cursor > 0:
                        dashboard_state.text = (
                            dashboard_state.text[: dashboard_state.cursor - 1]
                            + dashboard_state.text[dashboard_state.cursor :]
                        )
                        dashboard_state.cursor -= 1
                        purge_orphaned_pastes(dashboard_state)
                        draw_needed = True
                elif key == curses.KEY_DC or key == "\x04":
                    if dashboard_state.cursor < len(dashboard_state.text):
                        dashboard_state.text = (
                            dashboard_state.text[: dashboard_state.cursor]
                            + dashboard_state.text[dashboard_state.cursor + 1 :]
                        )
                        purge_orphaned_pastes(dashboard_state)
                        draw_needed = True
                elif key == "\x15":
                    dashboard_state.text = dashboard_state.text[dashboard_state.cursor :]
                    dashboard_state.cursor = 0
                    purge_orphaned_pastes(dashboard_state)
                    draw_needed = True
                elif key == "\x0b":
                    dashboard_state.text = dashboard_state.text[: dashboard_state.cursor]
                    purge_orphaned_pastes(dashboard_state)
                    draw_needed = True
                elif key == "\x17":
                    delete_previous_word(dashboard_state)
                    draw_needed = True
                elif key == "\x03":
                    dashboard_state.text = ""
                    dashboard_state.cursor = 0
                    dashboard_state.paste_payloads = {}
                    set_dashboard_status(
                        dashboard_state, "DRAFT CLEARED", "dim", 2.0
                    )
                    draw_needed = True
                elif key in ("\n", "\r", curses.KEY_ENTER):
                    if (
                        time.monotonic()
                        <= dashboard_state.paste_enter_suppress_until
                    ):
                        insert_composer_text(dashboard_state, "\n")
                        dashboard_state.paste_enter_suppress_until = (
                            time.monotonic() + PASTE_ENTER_SUPPRESS_SECONDS
                        )
                        draw_needed = True
                        continue
                    dashboard_state.paste_enter_suppress_until = 0.0
                    message = outbound_composer_message(
                        dashboard_state.text, dashboard_state.paste_payloads
                    )
                    if not message.strip():
                        set_dashboard_status(
                            dashboard_state,
                            "TYPE A MESSAGE BEFORE SENDING",
                            "orange",
                            3.0,
                        )
                        draw_needed = True
                        continue
                    selected_session_id = active_session_id()
                    if selected_session_id is None:
                        set_dashboard_status(
                            dashboard_state,
                            "NO ACTIVE WORKSPACE",
                            "red",
                            3.0,
                        )
                        draw_needed = True
                        continue
                    selected = workspaces[
                        selected_workspace_index(workspaces, selected_session_id)
                    ]
                    if selected.app not in {"Codex", "Claude"} or not selected.pane_id:
                        set_dashboard_status(
                            dashboard_state,
                            "SELECTED PANE HAS NO VERIFIED CHAT COMPOSER",
                            "red",
                            5.0,
                        )
                        draw_needed = True
                        continue
                    dashboard_state.sending = True
                    dashboard_state.inflight_session = selected.session.session_id
                    dashboard_state.inflight_message = message
                    dashboard_state.inflight_draft = dashboard_state.text
                    dashboard_state.inflight_paste_payloads = dict(
                        dashboard_state.paste_payloads
                    )
                    dashboard_state.drafts[selected.session.session_id] = ""
                    dashboard_state.draft_cursors[selected.session.session_id] = 0
                    dashboard_state.draft_paste_payloads[
                        selected.session.session_id
                    ] = {}
                    dashboard_state.text = ""
                    dashboard_state.cursor = 0
                    dashboard_state.paste_payloads = {}
                    set_dashboard_status(
                        dashboard_state,
                        f"VERIFYING SUBMISSION TO {safe_label(selected.session.name)}…",
                        "busy_2",
                        30.0,
                    )
                    threading.Thread(
                        target=submit_dashboard_message,
                        args=(socket, selected, message, send_results),
                        daemon=True,
                    ).start()
                    draw_needed = True
                elif isinstance(key, str) and key.isprintable():
                    if not insert_composer_text(dashboard_state, key):
                        set_dashboard_status(
                            dashboard_state,
                            "MESSAGE LIMIT REACHED",
                            "orange",
                            3.0,
                        )
                    draw_needed = True
        finally:
            try:
                curses.mousemask(0)
            except curses.error:
                pass
            try:
                os.write(sys.stdout.fileno(), b"\x1b[?2004l")
            except OSError:
                pass

    try:
        return curses.wrapper(dashboard_loop)
    except curses.error as exc:
        print(f"tmuxius could not initialize the terminal: {exc}", file=sys.stderr)
        return 2


