    r"private[-_ ]?key|password|passwd|secret|token|mnemonic|seed phrase)\b|"
    r"(?:^|[/ ])\.env(?:\b|/))"
)
SECRET_VALUE_RE = re.compile(
    r"(?i)(?:\beyJ[A-Za-z0-9_-]{12,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b|"
    r"\b(?:sk|pk)_(?:live|test)_[A-Za-z0-9]{12,}\b|\b[0-9a-f]{48,}\b|"
    r"\b[A-Za-z0-9+/=_-]{64,}\b)"
)
