class TmuxError(RuntimeError):
    pass


class Colors:
    def __init__(self, enabled: bool) -> None:
        self.enabled = enabled
        self.bold = "\033[1m" if enabled else ""
        self.dim = "\033[2m" if enabled else ""
        self.cyan = "\033[36m" if enabled else ""
        self.green = "\033[32m" if enabled else ""
        self.yellow = "\033[33m" if enabled else ""
        self.orange = "\033[38;5;208m" if enabled else ""
        # Dark enough to read as complete/inactive without disappearing on the
        # default black terminal background.
        self.complete = "\033[38;5;238m" if enabled else ""
        self.red = "\033[31m" if enabled else ""
        self.busy_gradient = (
            "\033[38;5;75m",
            "\033[38;5;69m",
            "\033[38;5;99m",
            "\033[38;5;135m",
        ) if enabled else ("",)
        self.reset = "\033[0m" if enabled else ""

    def busy(self, value: str) -> str:
        """Render text blue-to-purple without changing its visible width."""
        if not self.enabled:
            return value
        visible_length = len(value.rstrip())
        if visible_length <= 1:
            return f"{self.busy_gradient[0]}{value}{self.reset}"
        rendered: list[str] = []
        last_index = len(self.busy_gradient) - 1
        for index, character in enumerate(value):
            if index >= visible_length:
                rendered.append(character)
                continue
            color_index = round(index * last_index / (visible_length - 1))
            rendered.append(f"{self.busy_gradient[color_index]}{character}")
        return "".join(rendered) + self.reset


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Show tmux workspace summaries or open an interactive monitor that "
            "submits only explicit user-entered messages."
        )
    )
    parser.add_argument("--socket", help="Exact tmux socket path (defaults to this user's server)")
    parser.add_argument(
        "--history-lines",
        type=int,
        default=0,
        help=(
            "maximum tmux history lines to capture per selected chat; "
            "0 uses the pane's complete retained history (default)"
        ),
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--watch", dest="watch", action="store_true",
                      help="open the live full-screen dashboard (default)")
    mode.add_argument("--summary", dest="watch", action="store_false",
                      help="print a workspace summary and exit")
    parser.set_defaults(watch=True)
    parser.add_argument("--version", action="version", version=f"Tmuxius {VERSION}")
    parser.add_argument(
        "--interval",
        type=float,
        default=0.5,
        help="selected-chat refresh interval in seconds (default: 0.5)",
    )
    parser.add_argument("--no-color", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.history_lines != 0 and not 20 <= args.history_lines <= 200000:
        parser.error("--history-lines must be 0 or between 20 and 200000")
    if not 0.25 <= args.interval <= 60:
        parser.error("--interval must be between 0.25 and 60 seconds")
    return args


def tmux_command(socket: str | None, *arguments: str) -> list[str]:
    command = ["tmux"]
    if socket:
        command.extend(["-S", socket])
    command.extend(arguments)
    return command


def run_tmux(socket: str | None, *arguments: str, timeout: float = 2.0) -> str:
    try:
        result = subprocess.run(
            tmux_command(socket, *arguments),
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise TmuxError(str(exc)) from exc
    if result.returncode != 0:
        detail = clean_text(result.stderr).strip() or f"tmux exited {result.returncode}"
        raise TmuxError(detail)
    return result.stdout


def clean_text(value: str) -> str:
    value = ANSI_RE.sub("", value)
    value = CONTROL_RE.sub("", value)
    return SPACE_RE.sub(" ", value).strip()


def sgr_parameters(value: str) -> list[int]:
    """Normalize semicolon and modern colon-form SGR parameters."""
    if not value:
        return [0]
    parameters: list[int] = []
    for field in value.split(";"):
        if ":" not in field:
            try:
                parameters.append(int(field) if field else 0)
            except ValueError:
                continue
            continue
        components = field.split(":")
        try:
            command = int(components[0])
            mode = int(components[1])
        except (IndexError, ValueError):
            continue
        if command not in {38, 48}:
            parameters.append(command)
            continue
        if mode == 5 and len(components) >= 3:
            try:
                parameters.extend((command, mode, int(components[-1])))
            except ValueError:
                continue
        elif mode == 2 and len(components) >= 5:
            try:
                parameters.extend(
                    (command, mode, *(int(component) for component in components[-3:]))
                )
            except ValueError:
                continue
    return parameters or [0]


@functools.lru_cache(maxsize=512)
def apply_sgr(style: TerminalStyle, value: str) -> TerminalStyle:
    parameters = sgr_parameters(value)
    foreground = style.foreground
    background = style.background
    bold = style.bold
    dim = style.dim
    italic = style.italic
    underline = style.underline
    reverse = style.reverse
    strike = style.strike
    index = 0
    while index < len(parameters):
        parameter = parameters[index]
        index += 1
        if parameter == 0:
            foreground = None
            background = None
            bold = dim = italic = underline = reverse = strike = False
        elif parameter == 1:
            bold = True
        elif parameter == 2:
            dim = True
        elif parameter == 3:
            italic = True
        elif parameter in {4, 21}:
            underline = True
        elif parameter == 7:
            reverse = True
        elif parameter == 9:
            strike = True
        elif parameter == 22:
            bold = dim = False
        elif parameter == 23:
            italic = False
        elif parameter == 24:
            underline = False
        elif parameter == 27:
            reverse = False
        elif parameter == 29:
            strike = False
        elif 30 <= parameter <= 37:
            foreground = parameter - 30
        elif 90 <= parameter <= 97:
            foreground = parameter - 90 + 8
        elif parameter == 39:
            foreground = None
        elif 40 <= parameter <= 47:
            background = parameter - 40
        elif 100 <= parameter <= 107:
            background = parameter - 100 + 8
        elif parameter == 49:
            background = None
        elif parameter in {38, 48} and index < len(parameters):
            mode = parameters[index]
            index += 1
            color: int | tuple[int, int, int] | None = None
            if mode == 5 and index < len(parameters):
                color = max(0, min(255, parameters[index]))
                index += 1
            elif mode == 2 and index + 2 < len(parameters):
                color = tuple(
                    max(0, min(255, component))
                    for component in parameters[index : index + 3]
                )
                index += 3
            if color is not None:
                if parameter == 38:
                    foreground = color
                else:
                    background = color
    return TerminalStyle(
        foreground,
        background,
        bold,
        dim,
        italic,
        underline,
        reverse,
        strike,
    )


def merge_preview_spans(spans: list[PreviewSpan]) -> tuple[PreviewSpan, ...]:
    merged: list[PreviewSpan] = []
    for span in spans:
        if span.end <= span.start:
            continue
        if (
            merged
            and merged[-1].end == span.start
            and merged[-1].style == span.style
        ):
            merged[-1] = PreviewSpan(merged[-1].start, span.end, span.style)
        else:
            merged.append(span)
    return tuple(merged)


def parse_preview_text(
    value: str, *, preserve_default_style: bool = False
) -> tuple[str, tuple[PreviewSpan, ...]]:
    """Remove terminal controls while retaining tmux-captured SGR style runs."""
    if "\x1b" not in value:
        text = CONTROL_RE.sub("", value.replace("\u00a0", " ")).expandtabs(4).rstrip()
        spans = (
            (PreviewSpan(0, len(text), TerminalStyle()),)
            if preserve_default_style and text
            else ()
        )
        return text, spans
    fragments: list[str] = []
    span_runs: list[tuple[int, int, TerminalStyle]] = []
    style = TerminalStyle()
    saw_sgr = False
    length = 0

    def append_fragment(fragment: str) -> None:
        nonlocal length
        fragment = CONTROL_RE.sub("", fragment.replace("\u00a0", " "))
        if not fragment:
            return
        if "\t" in fragment:
            expanded: list[str] = []
            column = length
            for character in fragment:
                if character == "\t":
                    spaces = 4 - column % 4
                    expanded.append(" " * spaces)
                    column += spaces
                else:
                    expanded.append(character)
                    column += 1
            fragment = "".join(expanded)
        start = length
        fragments.append(fragment)
        length += len(fragment)
        if span_runs and span_runs[-1][1] == start and span_runs[-1][2] == style:
            span_runs[-1] = (span_runs[-1][0], length, style)
        else:
            span_runs.append((start, length, style))

    cursor = 0
    for ansi in ANSI_RE.finditer(value):
        append_fragment(value[cursor : ansi.start()])
        sgr = SGR_RE.fullmatch(ansi.group(0))
        if sgr:
            saw_sgr = True
            style = apply_sgr(style, sgr.group(1))
        cursor = ansi.end()
    append_fragment(value[cursor:])

    text = "".join(fragments).rstrip()
    if not (saw_sgr or preserve_default_style) or not text:
        return text, ()
    end = len(text)
    return text, merge_preview_spans(
        [
            PreviewSpan(start, min(stop, end), run_style)
            for start, stop, run_style in span_runs
            if start < end
        ]
    )


def preview_span_slice(
    line: PreviewLine,
    start: int,
    end: int,
    destination_start: int,
    *,
    materialize_default: bool = False,
) -> list[PreviewSpan]:
    if end <= start:
        return []
    if not line.spans:
        return (
            [PreviewSpan(destination_start, destination_start + end - start, TerminalStyle())]
            if materialize_default
            else []
        )
    sliced: list[PreviewSpan] = []
    cursor = start
    for span in line.spans:
        overlap_start = max(start, span.start)
        overlap_end = min(end, span.end)
        if overlap_end <= overlap_start:
            continue
        if materialize_default and overlap_start > cursor:
            sliced.append(
                PreviewSpan(
                    destination_start + cursor - start,
                    destination_start + overlap_start - start,
                    TerminalStyle(),
                )
            )
        sliced.append(
            PreviewSpan(
                destination_start + overlap_start - start,
                destination_start + overlap_end - start,
                span.style,
            )
        )
        cursor = overlap_end
    if materialize_default and cursor < end:
        sliced.append(
            PreviewSpan(
                destination_start + cursor - start,
                destination_start + end - start,
                TerminalStyle(),
            )
        )
    return sliced


def preview_style_at(line: PreviewLine, position: int) -> TerminalStyle:
    for span in line.spans:
        if span.start <= position < span.end:
            return span.style
    return TerminalStyle()


def is_paste_token(character: str) -> bool:
    return len(character) == 1 and PASTE_TOKEN_START <= ord(character) <= PASTE_TOKEN_END


def sanitize_composer_input(value: str) -> str:
    """Keep text and paste newlines while dropping terminal-control payloads."""
    value = ANSI_RE.sub("", value)
    value = value.replace("\r\n", "\n").replace("\r", "\n")
    return "".join(
        character
        for character in value
        if character in {"\n", "\t"}
        or (
            ord(character) >= 32
            and ord(character) != 127
            and not is_paste_token(character)
        )
    )


def expand_composer_text(value: str, paste_payloads: dict[str, str]) -> str:
    return "".join(
        paste_payloads.get(character, "") if is_paste_token(character) else character
        for character in value
    )


def composer_expanded_length(value: str, paste_payloads: dict[str, str]) -> int:
    return sum(
        len(paste_payloads.get(character, ""))
        if is_paste_token(character)
        else 1
        for character in value
    )


def purge_orphaned_pastes(state: DashboardState) -> None:
    used = {character for character in state.text if is_paste_token(character)}
    state.paste_payloads = {
        token: payload
        for token, payload in state.paste_payloads.items()
        if token in used
    }


def allocate_paste_token(state: DashboardState) -> str:
    used = set(state.paste_payloads)
    used.update(state.inflight_paste_payloads)
    for payloads in state.draft_paste_payloads.values():
        used.update(payloads)
    capacity = PASTE_TOKEN_END - PASTE_TOKEN_START + 1
    for _ in range(capacity):
        codepoint = state.next_paste_token
        state.next_paste_token += 1
        if state.next_paste_token > PASTE_TOKEN_END:
            state.next_paste_token = PASTE_TOKEN_START
        token = chr(codepoint)
        if token not in used:
            return token
    raise RuntimeError("too many pending pasted-content objects")


def insert_composer_text(
    state: DashboardState, value: str, *, pasted: bool = False
) -> bool:
    cleaned = sanitize_composer_input(value)
    if not cleaned:
        return False
    current_chars = composer_expanded_length(state.text, state.paste_payloads)
    if current_chars + len(cleaned) > MAX_MESSAGE_CHARS:
        return False
    inserted = cleaned
    if pasted and len(cleaned) > LARGE_PASTE_CHAR_THRESHOLD:
        token = allocate_paste_token(state)
        state.paste_payloads[token] = cleaned
        inserted = token
    state.text = state.text[: state.cursor] + inserted + state.text[state.cursor :]
    state.cursor += len(inserted)
    return True


def outbound_composer_message(
    value: str, paste_payloads: dict[str, str] | None = None
) -> str:
    # Submission is a separate verified Enter after tmux bracketed-paste, so a
    # trailing newline remains content rather than becoming an early submit.
    expanded = expand_composer_text(value, paste_payloads or {})
    return sanitize_composer_input(expanded)


def render_composer_text(
    value: str, paste_payloads: dict[str, str] | None = None
) -> str:
    payloads = paste_payloads or {}
    rendered: list[str] = []
    for character in value:
        if is_paste_token(character):
            rendered.append(
                f"[Pasted Content {len(payloads.get(character, ''))} chars]"
            )
        elif character == "\n":
            rendered.append(" \\n ")
        elif character == "\t":
            rendered.append(" \\t ")
        else:
            rendered.append(character)
    return "".join(rendered)


def delete_previous_word(state: DashboardState) -> None:
    if state.cursor <= 0:
        return
    if is_paste_token(state.text[state.cursor - 1]):
        state.text = state.text[: state.cursor - 1] + state.text[state.cursor :]
        state.cursor -= 1
        purge_orphaned_pastes(state)
        return
    start = state.cursor
    while start > 0 and state.text[start - 1].isspace():
        start -= 1
    while start > 0 and not state.text[start - 1].isspace():
        start -= 1
    state.text = state.text[:start] + state.text[state.cursor :]
    state.cursor = start
    purge_orphaned_pastes(state)


def safe_label(value: str, fallback: str = "?") -> str:
    cleaned = clean_text(value)
    if not cleaned:
        return fallback
    return cleaned[:32]


def safe_summary(value: str, min_length: int = 12) -> str | None:
    cleaned = clean_text(value).strip(" │─└┌┐┘")
    cleaned = re.sub(r"^[•●◦›❯]\s*", "", cleaned)
    cleaned = cleaned.replace("`", "")
    if len(cleaned) < min_length:
        return None
    if SECRET_WORD_RE.search(cleaned) or SECRET_VALUE_RE.search(cleaned):
        return None
    if cleaned.count("{") + cleaned.count("[") >= 3:
        return None
    return cleaned


def explicit_window_subject(pane: Pane) -> str | None:
    """Return only a deliberate tmux name, never its automatic command label."""
    if pane.automatic_rename:
        return None
    return safe_summary(pane.window_name, min_length=1)


def workspace_subject(workspace: Workspace) -> str:
    return workspace.window_title or workspace.summary


def transcript_summary(snapshot: str) -> str:
    lines = snapshot.splitlines()
    for raw in reversed(lines):
        line = clean_text(raw)
        match = re.match(r"^[•●]\s+(.+)$", line)
        if not match:
            continue
        candidate = match.group(1).strip()
        if ACTION_PREFIX_RE.match(candidate):
            continue
        safe = safe_summary(candidate)
        if safe:
            return safe

    for raw in reversed(lines):
        line = clean_text(raw)
        match = re.match(r"^[›❯]\s+(.+)$", line)
        if not match:
            continue
        candidate = match.group(1).strip()
        if PROMPT_PLACEHOLDER_RE.match(candidate):
            continue
        safe = safe_summary(candidate)
        if safe:
            return safe
    return "No safe recent summary available"


def preview_line_kind(line: str, previous_kind: str) -> str:
    content = line.lstrip()
    lowered = content.casefold()
    if content.startswith(("›", "❯")):
        return "user"
    if content.startswith("◦") or lowered.startswith(
        ("working (", "computing (", "waiting for background terminal")
    ):
        return "working"
    if "background terminal" in lowered and re.match(
        r"(?i)^(?:[•●·]\s*)?\d+\s+background terminals?\s+running\b", content
    ):
        return "working"
    if content.startswith(("•", "●")):
        body = re.sub(r"^[•●]\s*", "", content)
        if body.casefold().startswith(
            ("working (", "computing (", "waiting for background terminal")
        ):
            return "working"
        return "tool" if ACTION_PREFIX_RE.match(body) else "assistant"
    if content.startswith(("└", "├", "│", "…")):
        return "tool"
    if previous_kind == "tool" and re.match(r"^(?:\d+\s+)?\+(?!\+)", content):
        return "addition"
    if previous_kind == "tool" and re.match(r"^(?:\d+\s+)?-(?!-)", content):
        return "deletion"
    if line[:1].isspace() and previous_kind in {"user", "assistant", "tool"}:
        return previous_kind
    return "body"


def is_preview_separator(line: str) -> bool:
    content = line.strip()
    return len(content) >= 8 and set(content) <= {
        "-",
        "_",
        "=",
        "─",
        "━",
        "┄",
        "┈",
    }


def reflow_preview_paragraphs(lines: list[PreviewLine]) -> list[PreviewLine]:
    """Join narrow Codex visual wraps without changing the monitored pane."""
    reflowed: list[PreviewLine] = []
    for line in lines:
        content = line.text.lstrip(" ")
        leading_spaces = len(line.text) - len(content)
        can_join = (
            bool(reflowed)
            and line.kind in {"user", "assistant"}
            and reflowed[-1].kind == line.kind
            and leading_spaces == 2
            and bool(content)
            and not PREVIEW_REFLOW_BOUNDARY_RE.match(content)
        )
        if can_join:
            previous = reflowed[-1]
            previous_text = previous.text.rstrip()
            content_start = len(line.text) - len(content)
            joined_text = f"{previous_text} {content}"
            joined_spans: tuple[PreviewSpan, ...] = ()
            if previous.spans or line.spans:
                span_list = preview_span_slice(
                    previous,
                    0,
                    len(previous_text),
                    0,
                    materialize_default=True,
                )
                gap_start = len(previous_text)
                gap_style = preview_style_at(
                    line, min(content_start, max(0, len(line.text) - 1))
                )
                span_list.append(PreviewSpan(gap_start, gap_start + 1, gap_style))
                span_list.extend(
                    preview_span_slice(
                        line,
                        content_start,
                        len(line.text),
                        gap_start + 1,
                        materialize_default=True,
                    )
                )
                joined_spans = merge_preview_spans(span_list)
            reflowed[-1] = replace(
                previous,
                text=joined_text,
                spans=joined_spans,
            )
        else:
            reflowed.append(line)
    return reflowed


def safe_preview_lines(
    snapshot: str, limit: int | None = None
) -> tuple[PreviewLine, ...]:
    preview: list[PreviewLine] = []
    previous_kind = "body"
    preserve_default_style = bool(SGR_RE.search(snapshot))
    for raw in snapshot.splitlines():
        line, spans = parse_preview_text(
            raw, preserve_default_style=preserve_default_style
        )
        content = line.lstrip()
        if not content:
            if preview and preview[-1].kind != "blank":
                preview.append(PreviewLine("", "blank"))
            continue
        placeholder_candidate = re.sub(r"^[›❯]\s*", "", content)
        if PROMPT_PLACEHOLDER_RE.match(placeholder_candidate) or re.match(
            r"(?i)^gpt-\d", content
        ):
            continue
        if is_preview_separator(line):
            kind = "separator"
            rendered = "─"
            spans = ()
        else:
            kind = preview_line_kind(line, previous_kind)
            rendered = line
        if kind == "separator" and preview and preview[-1].kind == "separator":
            continue
        preview.append(PreviewLine(rendered, kind, spans=spans))
        if kind not in {"blank", "separator", "addition", "deletion"}:
            previous_kind = kind
    while preview and preview[-1].kind == "blank":
        preview.pop()
    preview = reflow_preview_paragraphs(preview)
    if limit is not None:
        if limit <= 0:
            return ()
        preview = preview[-limit:]
    return tuple(preview)


def session_sort_key(session: Session) -> tuple[int, int | str]:
    if session.name.isdecimal():
        return (0, int(session.name))
    return (1, session.name.casefold())


def list_sessions(socket: str | None) -> list[Session]:
    output = run_tmux(
        socket,
        "list-sessions",
        "-F",
        SEP.join(
            ["#{session_id}", "#{session_name}", "#{session_attached}", "#{session_activity}"]
        ),
    )
    sessions: list[Session] = []
    for raw in output.splitlines():
        session_id, separator, remainder = raw.partition(SEP)
        if not separator:
            continue
        fields = remainder.rsplit(SEP, 2)
        if len(fields) != 3:
            continue
        name, attached_text, activity_text = fields
        try:
            attached = int(attached_text)
            activity = int(activity_text)
        except ValueError:
            continue
        sessions.append(Session(session_id, name, attached, activity))
    return sorted(sessions, key=session_sort_key)


def active_pane(socket: str | None, session: Session) -> Pane:
    output = run_tmux(
        socket,
        "display-message",
        "-p",
        "-t",
        session.session_id,
        SEP.join(
            [
                "#{window_index}",
                "#{pane_index}",
                "#{pane_id}",
                "#{pane_current_command}",
                "#{pane_pid}",
                "#{window_name}",
                "#{?automatic-rename,1,0}",
                f"#{{{CODEX_NAME_CACHE_OPTION}}}",
            ]
        ),
    ).rstrip("\n")
    fields = output.split(SEP)
    if len(fields) != 8:
        raise TmuxError("active pane metadata was incomplete")
    try:
        pid = int(fields[4])
    except ValueError as exc:
        raise TmuxError("active pane PID was invalid") from exc
    return Pane(
        fields[0],
        fields[1],
        fields[2],
        fields[3],
        pid,
        clean_text(fields[5]),
        fields[6] == "1",
        fields[7],
    )


def list_active_panes(socket: str | None) -> dict[str, Pane]:
    output = run_tmux(
        socket,
        "list-panes",
        "-a",
        "-F",
        SEP.join(
            [
                "#{session_id}",
                "#{window_active}",
                "#{pane_active}",
                "#{window_index}",
                "#{pane_index}",
                "#{pane_id}",
                "#{pane_current_command}",
                "#{pane_pid}",
                "#{window_name}",
                "#{?automatic-rename,1,0}",
                f"#{{{CODEX_NAME_CACHE_OPTION}}}",
            ]
        ),
    )
    panes: dict[str, Pane] = {}
    for raw in output.splitlines():
        fields = raw.split(SEP)
        if len(fields) != 11 or fields[1] != "1" or fields[2] != "1":
            continue
        try:
            pid = int(fields[7])
        except ValueError:
            continue
        panes[fields[0]] = Pane(
            fields[3],
            fields[4],
            fields[5],
            fields[6],
            pid,
            clean_text(fields[8]),
            fields[9] == "1",
            fields[10],
        )
    return panes


def capture_start_line(history_lines: int) -> str:
    return "-" if history_lines == 0 else f"-{history_lines}"


def capture_snapshot(socket: str | None, pane: Pane, history_lines: int) -> str:
    return run_tmux(
        socket,
        "capture-pane",
        "-e",
        "-p",
        "-J",
        "-S",
        capture_start_line(history_lines),
        "-t",
        pane.pane_id,
    )


def capture_snapshots(
    socket: str | None, panes: list[Pane], history_lines: int
) -> dict[str, str]:
    """Capture several pane tails through one tmux client connection."""
    if not panes:
        return {}
    nonce = uuid.uuid4().hex
    marker_to_pane: dict[str, str] = {}
    arguments: list[str] = []
    for index, pane in enumerate(panes):
        marker = f"__TMUX_DASHBOARD_{nonce}_{index}__"
        marker_to_pane[marker] = pane.pane_id
        if arguments:
            arguments.append(";")
        arguments.extend(
            ["display-message", "-p", "-t", pane.pane_id, marker]
        )
        arguments.extend(
            [
                ";",
                "capture-pane",
                "-e",
                "-p",
                "-J",
                "-S",
                capture_start_line(history_lines),
                "-t",
                pane.pane_id,
            ]
        )
    output = run_tmux(
        socket,
        *arguments,
        timeout=max(2.0, min(10.0, 0.5 * len(panes))),
    )
    snapshots: dict[str, list[str]] = {
        pane.pane_id: [] for pane in panes
    }
    active_pane_id: str | None = None
    for line in output.splitlines(keepends=True):
        marker = line.rstrip("\r\n")
        if marker in marker_to_pane:
            active_pane_id = marker_to_pane[marker]
            continue
        if active_pane_id is not None:
            snapshots[active_pane_id].append(line)
    return {
        pane_id: "".join(lines)
        for pane_id, lines in snapshots.items()
    }


def semantic_snapshot_signature(snapshot: str) -> str:
    """Hash visible content while ignoring busy-timer ticks and line wrapping."""
    # Full selected-chat captures and lightweight background captures use
    # different history depths. Compare only their shared live tail.
    live_tail = "\n".join(snapshot.splitlines()[-40:])
    normalized = ANSI_RE.sub("", live_tail).replace("\u00a0", " ")
    normalized = BUSY_TICK_RE.sub(r"\1 (active)", normalized)
    normalized = SPACE_RE.sub(" ", normalized).strip()
    return hashlib.blake2s(normalized.encode("utf-8"), digest_size=12).hexdigest()


def preview_snapshot_signature(
    snapshot: str, semantic_signature: str | None = None
) -> str:
    """Cache identical frames while retaining timer, style, and history changes."""
    return hashlib.blake2s(snapshot.encode("utf-8"), digest_size=12).hexdigest()



def read_processes() -> dict[int, Process]:
    try:
        result = subprocess.run(
            ["ps", "-ww", "-eo", "pid=,ppid=,pgid=,tpgid=,comm=,args="],
            check=False,
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {}
    if result.returncode != 0:
        return {}
    processes: dict[int, Process] = {}
    for line in result.stdout.splitlines():
        fields = line.strip().split(None, 5)
        if len(fields) < 5:
            continue
        try:
            pid, ppid, pgid, tpgid = map(int, fields[:4])
        except ValueError:
            continue
        processes[pid] = Process(
            pid,
            ppid,
            pgid,
            tpgid,
            fields[4],
            fields[5] if len(fields) == 6 else "",
        )
    return processes


def process_family(root_pid: int, processes: dict[int, Process]) -> list[Process]:
    children: dict[int, list[int]] = {}
    for process in processes.values():
        children.setdefault(process.ppid, []).append(process.pid)
    found: list[Process] = []
    pending = [root_pid]
    seen: set[int] = set()
    while pending and len(seen) < 256:
        pid = pending.pop()
        if pid in seen:
            continue
        seen.add(pid)
        process = processes.get(pid)
        if process:
            found.append(process)
        pending.extend(children.get(pid, []))
    return found


def thread_ref_from_rollout_path(path: str) -> tuple[str, str, str] | None:
    marker = "/sessions/"
    if marker not in path:
        return None
    match = THREAD_ID_RE.search(path)
    if not match:
        return None
    return path.split(marker, 1)[0], match.group(1), path


def codex_thread_refs(
    pane: Pane, processes: dict[int, Process]
) -> list[tuple[str, str, str]]:
    family = process_family(pane.pid, processes)
    pane_process = processes.get(pane.pid)
    foreground_pgid = pane_process.tpgid if pane_process else -1
    codex_processes = [process for process in family if process.command == "codex"]
    codex_processes.sort(key=lambda process: process.pgid != foreground_pgid)
    references: list[tuple[str, str, str]] = []
    seen: set[tuple[str, str, str]] = set()

    for process in codex_processes:
        if foreground_pgid > 0 and process.pgid != foreground_pgid:
            continue
        try:
            descriptors = os.scandir(f"/proc/{process.pid}/fd")
        except OSError:
            continue
        with descriptors:
            for descriptor in descriptors:
                try:
                    target = os.readlink(descriptor.path)
                except OSError:
                    continue
                reference = thread_ref_from_rollout_path(target)
                if reference and reference not in seen:
                    seen.add(reference)
                    references.append(reference)
    return references


def codex_title_candidate(
    name: object,
    title: object,
    first_user_message: object,
    thread_source: object,
    updated_at: object,
    retained_name: object = None,
) -> tuple[tuple[int, int, int], str] | None:
    source_rank = 0
    candidate: str | None = None
    for rank, value, min_length in (
        (3, name, 1),
        (3, retained_name, 1),
        (2, title, 3),
        (1, first_user_message, 3),
    ):
        candidate = safe_summary(str(value or ""), min_length=min_length)
        if candidate:
            source_rank = rank
            break
    if candidate is None:
        return None
    primary_rank = 0 if str(thread_source or "").casefold() == "subagent" else 1
    try:
        recency = int(updated_at or 0)
    except (TypeError, ValueError):
        recency = 0
    return (primary_rank, source_rank, recency), candidate[:240]


def retained_codex_names(pane: Pane) -> dict[str, str]:
    try:
        value = json.loads(pane.codex_name_cache or "{}")
    except (TypeError, ValueError):
        return {}
    if not isinstance(value, dict):
        return {}
    retained: dict[str, str] = {}
    for thread_id, name in value.items():
        if (
            not isinstance(thread_id, str)
            or not THREAD_ID_VALUE_RE.fullmatch(thread_id)
        ):
            continue
        safe_name = safe_summary(str(name or ""), min_length=1)
        if safe_name:
            retained[thread_id] = safe_name[:240]
    return retained


def retained_codex_name(
    pane: Pane, thread_id: str, current_name: object
) -> str | None:
    observed = safe_summary(str(current_name or ""), min_length=1)
    if observed:
        return observed[:240]
    return retained_codex_names(pane).get(thread_id)


def persist_codex_name(
    socket: str | None, pane: Pane, details: CodexThreadDetails
) -> None:
    thread_id = details.thread_id or ""
    name = details.current_name or ""
    if not THREAD_ID_VALUE_RE.fullmatch(thread_id) or not name:
        return
    retained = retained_codex_names(pane)
    if retained.get(thread_id) == name:
        return
    retained.pop(thread_id, None)
    retained[thread_id] = name
    while len(retained) > MAX_RETAINED_CODEX_NAMES:
        retained.pop(next(iter(retained)))
    encoded = json.dumps(retained, ensure_ascii=False, separators=(",", ":"))
    try:
        run_tmux(
            socket,
            "set-option",
            "-p",
            "-t",
            pane.pane_id,
            CODEX_NAME_CACHE_OPTION,
            encoded,
        )
    except TmuxError:
        # Subject collection must remain useful if pane metadata is read-only.
        return


def codex_thread_details(
    pane: Pane, processes: dict[int, Process]
) -> CodexThreadDetails:
    references = codex_thread_refs(pane, processes)
    if not references:
        return CodexThreadDetails(None, None)

    last_activity: float | None = None
    references_by_home: dict[str, list[tuple[str, str]]] = {}
    for codex_home, thread_id, rollout_path in references:
        references_by_home.setdefault(codex_home, []).append(
            (thread_id, rollout_path)
        )
        try:
            modified = os.stat(rollout_path).st_mtime
        except OSError:
            continue
        last_activity = max(last_activity or 0.0, modified)

    candidates: list[tuple[tuple[int, int, int], str, str, str | None]] = []
    for codex_home, home_references in references_by_home.items():
        thread_ids = list(dict.fromkeys(item[0] for item in home_references))
        placeholders = ",".join("?" for _ in thread_ids)
        database = os.path.join(codex_home, "state_5.sqlite")
        try:
            connection = sqlite3.connect(
                f"file:{database}?mode=ro", uri=True, timeout=0.2
            )
            try:
                try:
                    rows = connection.execute(
                        "SELECT id, name, title, first_user_message, "
                        "thread_source, updated_at FROM threads "
                        f"WHERE id IN ({placeholders})",
                        thread_ids,
                    ).fetchall()
                except sqlite3.OperationalError:
                    legacy_rows = connection.execute(
                        "SELECT id, name, title, first_user_message FROM threads "
                        f"WHERE id IN ({placeholders})",
                        thread_ids,
                    ).fetchall()
                    rows = [(*row, "", 0) for row in legacy_rows]
            finally:
                connection.close()
        except (OSError, sqlite3.Error):
            continue
        for (
            thread_id,
            name,
            title,
            first_user_message,
            thread_source,
            updated_at,
        ) in rows:
            current_name = safe_summary(str(name or ""), min_length=1)
            retained_name = retained_codex_name(pane, thread_id, current_name)
            candidate = codex_title_candidate(
                name,
                title,
                first_user_message,
                thread_source,
                updated_at,
                retained_name,
            )
            if candidate is not None:
                candidates.append((*candidate, thread_id, current_name))

    if not candidates:
        return CodexThreadDetails(None, last_activity)
    _, subject, thread_id, current_name = max(candidates, key=lambda item: item[0])
    return CodexThreadDetails(subject, last_activity, thread_id, current_name)


def app_name(pane: Pane, snapshot: str, processes: dict[int, Process]) -> str:
    family = process_family(pane.pid, processes)
    process_text = " ".join(f"{p.command} {p.args}" for p in family).casefold()
    tail = snapshot[-6000:].casefold()
    if re.search(r"(?:^|[/\s])codex(?:[/\s]|$)|@openai/codex", process_text):
        return "Codex"
    if re.search(r"(?:^|[/\s])claude(?:[/\s]|$)|@anthropic-ai/claude", process_text):
        return "Claude"
    if "gpt-5." in tail and "esc to interrupt" in tail:
        return "Codex"
    if "claude code" in tail:
        return "Claude"
    command = safe_label(pane.command, "shell")
    if command.casefold() in {"bash", "zsh", "fish", "sh", "dash"}:
        return "shell"
    return command[:10]


def work_state(snapshot: str) -> str:
    tail_lines = snapshot.splitlines()[-18:]
    tail = "\n".join(clean_text(line) for line in tail_lines)
    return "busy" if BUSY_RE.search(tail) else "ready"


def busy_duration(snapshot: str) -> int | None:
    tail_lines = snapshot.splitlines()[-24:]
    tail = "\n".join(clean_text(line) for line in tail_lines)
    matches = list(BUSY_DURATION_RE.finditer(tail))
    if not matches:
        return None
    hours, minutes, seconds = matches[-1].groups(default="0")
    return int(hours) * 3600 + int(minutes) * 60 + int(seconds)


def activity_tier(
    last_activity: float | None,
    state: str,
    now: float | None = None,
) -> str:
    if state == "busy":
        return "busy"
    if last_activity is None:
        return "unknown"
    current_time = time.time() if now is None else now
    age = max(0.0, current_time - last_activity)
    if age <= GREEN_ACTIVITY_SECONDS:
        return "green"
    if age < READY_ACTIVITY_SECONDS:
        return "recent"
    if age <= FINISHING_ACTIVITY_SECONDS:
        return "orange"
    return "complete"


def lifecycle_label(state: str, tier: str) -> str:
    if state == "busy":
        return "busy"
    if tier == "orange":
        return "finishing"
    if tier == "complete":
        return "complete"
    return "ready"


def format_elapsed(seconds: int | float | None) -> str:
    if seconds is None:
        return "-"
    total = max(0, int(seconds))
    if total < 60:
        return f"{total}s"
    if total < 3600:
        minutes, remainder = divmod(total, 60)
        return f"{minutes}m{remainder:02d}s"
    if total < 86400:
        hours, remainder = divmod(total, 3600)
        minutes = remainder // 60
        return f"{hours}h{minutes:02d}m"
    days, remainder = divmod(total, 86400)
    return f"{days}d{remainder // 3600:02d}h"


def format_activity_age(last_activity: float | None, now: float | None = None) -> str:
    if last_activity is None:
        return "unknown"
    current_time = time.time() if now is None else now
    age = max(0, int(current_time - last_activity))
    return "now" if age < 5 else format_elapsed(age)


def collect_workspaces(
    sessions: list[Session],
    socket: str | None,
    history_lines: int,
    *,
    exclude_pane_id: str | None = None,
) -> list[Workspace]:
    processes = read_processes()
    panes = list_active_panes(socket)
    workspaces: list[Workspace] = []
    for session in sessions:
        pane = panes.get(session.session_id)
        if pane is not None and pane.pane_id == exclude_pane_id:
            continue
        if pane is None:
            workspaces.append(
                Workspace(session, "", "?", "?", "Summary unavailable", None, None, ())
            )
            continue
        try:
            snapshot = capture_snapshot(socket, pane, history_lines)
            app = app_name(pane, snapshot, processes)
            state = work_state(snapshot)
            thread_details = codex_thread_details(pane, processes)
            persist_codex_name(socket, pane, thread_details)
            summary = thread_details.subject or transcript_summary(snapshot)
            last_activity = (
                thread_details.last_activity
                if thread_details.last_activity is not None
                else float(session.activity)
            )
            duration = busy_duration(snapshot) if state == "busy" else None
            preview = safe_preview_lines(snapshot)
            signature = semantic_snapshot_signature(snapshot)
            preview_signature = preview_snapshot_signature(snapshot, signature)
        except TmuxError:
            app, state, summary = "?", "?", "Summary unavailable"
            last_activity, duration, preview = None, None, ()
            signature = preview_signature = ""
        workspaces.append(
            Workspace(
                session,
                pane.pane_id,
                app,
                state,
                summary,
                last_activity,
                duration,
                preview,
                signature,
                explicit_window_subject(pane),
                preview_signature,
            )
        )
    return workspaces


def refresh_workspace_from_snapshot(
    workspace: Workspace,
    session: Session,
    snapshot: str,
    *,
    now: float,
    include_preview: bool,
) -> Workspace:
    """Refresh volatile pane state without process scans or database reads."""
    signature = semantic_snapshot_signature(snapshot)
    last_activity = workspace.last_activity
    if workspace.signature and signature != workspace.signature:
        last_activity = max(last_activity or 0.0, now)
    elif not workspace.signature and session.activity:
        last_activity = max(last_activity or 0.0, float(session.activity))
    state = work_state(snapshot)
    preview = workspace.preview
    preview_signature = workspace.preview_signature
    if include_preview:
        preview_signature = preview_snapshot_signature(snapshot, signature)
        if not workspace.preview or preview_signature != workspace.preview_signature:
            preview = safe_preview_lines(snapshot)
    return replace(
        workspace,
        session=session,
        state=state,
        last_activity=last_activity,
        busy_seconds=busy_duration(snapshot) if state == "busy" else None,
        preview=preview,
        signature=signature,
        preview_signature=preview_signature,
    )


def refresh_workspace_details(
    workspaces: list[Workspace], panes: dict[str, Pane], socket: str | None
) -> list[Workspace]:
    """Occasionally refresh app identity and renamed Codex thread titles."""
    processes = read_processes()
    refreshed: list[Workspace] = []
    for workspace in workspaces:
        pane = panes.get(workspace.session.session_id)
        if pane is None:
            refreshed.append(workspace)
            continue
        rendered_preview = "\n".join(line.text for line in workspace.preview)
        app = app_name(pane, rendered_preview, processes)
        summary = workspace.summary
        last_activity = workspace.last_activity
        if app == "Codex":
            thread_details = codex_thread_details(pane, processes)
            persist_codex_name(socket, pane, thread_details)
            if thread_details.subject:
                summary = thread_details.subject
            if thread_details.last_activity is not None:
                last_activity = max(last_activity or 0.0, thread_details.last_activity)
        refreshed.append(
            replace(
                workspace,
                pane_id=pane.pane_id,
                app=app,
                summary=summary,
                last_activity=last_activity,
                window_title=explicit_window_subject(pane),
            )
        )
    return refreshed


def character_width(value: str) -> int:
    if unicodedata.combining(value) or unicodedata.category(value) in {"Cc", "Cf", "Cs"}:
        return 0
    if unicodedata.east_asian_width(value) in {"A", "F", "W"}:
        return 2
    return 1


def display_width(value: str) -> int:
    return sum(character_width(character) for character in value)


def display_slice(value: str, start: int, width: int) -> str:
    if width <= 0:
        return ""
    result: list[str] = []
    position = 0
    used = 0
    for character in value:
        columns = character_width(character)
        next_position = position + columns
        if next_position <= start:
            position = next_position
            continue
        if position < start and columns:
            position = next_position
            continue
        if columns and used + columns > width:
            break
        if columns == 0 and not result:
            position = next_position
            continue
        result.append(character)
        used += columns
        position = next_position
    return "".join(result)


def composer_display_window(
    text: str,
    cursor: int,
    width: int,
    paste_payloads: dict[str, str] | None = None,
) -> tuple[str, int]:
    rendered = render_composer_text(text, paste_payloads)
    rendered_prefix = render_composer_text(text[:cursor], paste_payloads)
    cursor_column = display_width(rendered_prefix)
    start = max(0, cursor_column - max(0, width - 1))
    visible = display_slice(rendered, start, width)
    return visible, max(0, min(max(0, width - 1), cursor_column - start))


def truncate_display(value: str, width: int) -> str:
    if width <= 0:
        return ""
    if display_width(value) <= width:
        return value

    suffix = "..."
    if width <= len(suffix):
        return suffix[:width]

    budget = width - len(suffix)
    used = 0
    result: list[str] = []
    for character in value:
        character_columns = character_width(character)
        if character_columns == 0:
            if result:
                result.append(character)
            continue
        if used + character_columns > budget:
            break
        result.append(character)
        used += character_columns
    return "".join(result).rstrip() + suffix


def display_field(value: str, width: int, *, align_right: bool = False) -> str:
    clipped = truncate_display(value, width)
    padding = " " * max(0, width - display_width(clipped))
    return f"{padding}{clipped}" if align_right else f"{clipped}{padding}"


def print_report(
    sessions: list[Session],
    socket: str | None,
    history_lines: int,
    colors: Colors,
) -> None:
    attached_total = sum(session.attached for session in sessions)
    terminal_width = max(1, shutil.get_terminal_size((100, 24)).columns)
    # Avoid the terminal's pending-wrap column. Termius may otherwise scroll once
    # when the following newline arrives, which looks like a hop on login.
    usable_width = max(1, terminal_width - 2)
    heading = "tmux workspaces"
    heading_detail = f"  {len(sessions)} open | {attached_total} attached"
    print()
    if display_width(heading) >= usable_width:
        print(f"{colors.bold}{truncate_display(heading, usable_width)}{colors.reset}")
    else:
        detail_width = usable_width - display_width(heading)
        print(
            f"{colors.bold}{heading}{colors.reset}"
            f"{colors.dim}{truncate_display(heading_detail, detail_width)}{colors.reset}"
        )
    workspaces = collect_workspaces(sessions, socket, history_lines)
    name_width = min(
        12,
        max(
            display_width(truncate_display(safe_label(workspace.session.name), 12))
            for workspace in workspaces
        ),
    )

    for workspace in workspaces:
        session = workspace.session
        name = display_field(safe_label(session.name), name_width, align_right=True)
        marker = "+" if session.attached else "-"
        connection_color = colors.green if session.attached else colors.dim
        app_field = display_field(workspace.app, 7)
        tier = activity_tier(workspace.last_activity, workspace.state)
        state_field = display_field(lifecycle_label(workspace.state, tier), 9)
        plain_prefix = f"  {name} {marker} {app_field} {state_field}  "
        summary_width = max(0, min(160, usable_width - display_width(plain_prefix)))
        state_color = {
            "green": colors.green,
            "recent": colors.yellow,
            "orange": colors.orange,
            "complete": colors.complete,
        }.get(tier, colors.dim)
        rendered_state = (
            colors.busy(state_field)
            if tier == "busy"
            else f"{state_color}{state_field}{colors.reset}"
        )
        print(
            f"  {colors.cyan}{name}{colors.reset} "
            f"{connection_color}{marker}{colors.reset} "
            f"{app_field} {rendered_state}  "
            f"{truncate_display(workspace_subject(workspace), summary_width)}"
        )

    legend = truncate_display("+ attached | - detached", usable_width)
    attach_hint = truncate_display("Attach: tmux attach -t <session>", usable_width)
    print(f"{colors.dim}{legend}{colors.reset}")
    activity_legend = (
        "blue-purple busy | green ready <=10m | yellow ready 10-30m | "
        "orange finishing 30-60m | dark complete >60m"
    )
    if display_width(activity_legend) <= usable_width:
        print(
            f"{colors.busy('blue-purple busy')} | "
            f"{colors.green}green ready <=10m{colors.reset} | "
            f"{colors.yellow}yellow ready 10-30m{colors.reset} | "
            f"{colors.orange}orange finishing 30-60m{colors.reset} | "
            f"{colors.complete}dark complete >60m{colors.reset}"
        )
    print(f"{colors.dim}{attach_hint}{colors.reset}")
    print()


XTERM_BASE_COLORS = (
    (0, 0, 0),
    (128, 0, 0),
    (0, 128, 0),
    (128, 128, 0),
    (0, 0, 128),
    (128, 0, 128),
    (0, 128, 128),
    (192, 192, 192),
    (128, 128, 128),
    (255, 0, 0),
    (0, 255, 0),
    (255, 255, 0),
    (0, 0, 255),
    (255, 0, 255),
    (0, 255, 255),
    (255, 255, 255),
)


def xterm_color_rgb(index: int) -> tuple[int, int, int]:
    index = max(0, min(255, index))
    if index < 16:
        return XTERM_BASE_COLORS[index]
    if index < 232:
        value = index - 16
        red, remainder = divmod(value, 36)
        green, blue = divmod(remainder, 6)
        levels = (0, 95, 135, 175, 215, 255)
        return levels[red], levels[green], levels[blue]
    gray = 8 + (index - 232) * 10
    return gray, gray, gray


def nearest_terminal_color(
    color: int | tuple[int, int, int], color_count: int
) -> int:
    if isinstance(color, int) and 0 <= color < color_count:
        return color
    rgb = xterm_color_rgb(color) if isinstance(color, int) else color
    candidates = min(256, max(1, color_count))
    return min(
        range(candidates),
        key=lambda index: sum(
            (component - candidate) ** 2
            for component, candidate in zip(rgb, xterm_color_rgb(index))
        ),
    )


def initialize_curses_palette(enabled: bool) -> dict[str, int]:
    global _captured_color_pairs
    global _captured_next_color_pair
    global _captured_colors_enabled
    global _captured_color_count
    global _captured_color_pair_count
    global _captured_default_background

    _captured_color_pairs = {}
    _captured_next_color_pair = CAPTURED_COLOR_PAIR_START
    _captured_colors_enabled = False
    _captured_color_count = 0
    _captured_color_pair_count = 0
    _captured_default_background = -1
    palette = {
        "normal": curses.A_NORMAL,
        "bold": curses.A_BOLD,
        "dim": curses.A_DIM,
        "green": curses.A_BOLD,
        "recent": curses.A_BOLD,
        "orange": curses.A_BOLD,
        "complete": curses.A_DIM,
        "red": curses.A_BOLD,
        "cyan": curses.A_BOLD,
        "busy_0": curses.A_BOLD,
        "busy_1": curses.A_BOLD,
        "busy_2": curses.A_BOLD,
        "busy_3": curses.A_BOLD,
        "selected": curses.A_BOLD,
        "topbar": curses.A_BOLD | curses.A_REVERSE,
        "panel_top": curses.A_BOLD | curses.A_REVERSE,
        "panel_bottom": curses.A_BOLD | curses.A_REVERSE,
    }
    if not enabled or not curses.has_colors():
        return palette

    curses.start_color()
    try:
        curses.use_default_colors()
        background = -1
    except curses.error:
        background = curses.COLOR_BLACK
    orange = 208 if getattr(curses, "COLORS", 0) > 208 else curses.COLOR_YELLOW
    color_count = getattr(curses, "COLORS", 0)
    _captured_colors_enabled = True
    _captured_color_count = color_count
    _captured_color_pair_count = getattr(curses, "COLOR_PAIRS", 0)
    _captured_default_background = background
    complete = 238 if color_count > 238 else curses.COLOR_BLACK
    busy_colors = (
        (75, 69, 99, 135)
        if color_count > 135
        else (
            curses.COLOR_BLUE,
            curses.COLOR_BLUE,
            curses.COLOR_MAGENTA,
            curses.COLOR_MAGENTA,
        )
    )
    topbar_foreground = 255 if color_count > 255 else curses.COLOR_WHITE
    topbar_background = 17 if color_count > 17 else curses.COLOR_BLUE
    for pair, foreground in (
        (1, curses.COLOR_GREEN),
        (2, orange),
        (3, curses.COLOR_RED),
        (4, curses.COLOR_CYAN),
        (5, busy_colors[0]),
        (6, busy_colors[1]),
        (7, busy_colors[2]),
        (8, busy_colors[3]),
        (10, complete),
        (11, curses.COLOR_YELLOW),
    ):
        try:
            curses.init_pair(pair, foreground, background)
        except curses.error:
            continue
    try:
        curses.init_pair(9, topbar_foreground, topbar_background)
    except curses.error:
        pass
    for pair, foreground, panel_background in (
        (12, topbar_foreground, 90 if color_count > 90 else curses.COLOR_MAGENTA),
        (13, curses.COLOR_BLACK, 178 if color_count > 178 else curses.COLOR_YELLOW),
    ):
        try:
            curses.init_pair(pair, foreground, panel_background)
        except curses.error:
            pass
    palette.update(
        {
            "green": curses.color_pair(1) | curses.A_BOLD,
            "recent": curses.color_pair(11) | curses.A_BOLD,
            "orange": curses.color_pair(2) | curses.A_BOLD,
            "complete": curses.color_pair(10),
            "red": curses.color_pair(3) | curses.A_BOLD,
            "cyan": curses.color_pair(4) | curses.A_BOLD,
            "busy_0": curses.color_pair(5) | curses.A_BOLD,
            "busy_1": curses.color_pair(6) | curses.A_BOLD,
            "busy_2": curses.color_pair(7) | curses.A_BOLD,
            "busy_3": curses.color_pair(8) | curses.A_BOLD,
            "selected": curses.color_pair(4) | curses.A_BOLD,
            "topbar": curses.color_pair(9) | curses.A_BOLD,
            "panel_top": curses.color_pair(12) | curses.A_BOLD,
            "panel_bottom": curses.color_pair(13) | curses.A_BOLD,
        }
    )
    return palette


def captured_style_attribute(style: TerminalStyle) -> int:
    global _captured_next_color_pair

    attribute = curses.A_NORMAL
    foreground: int | None = None
    background: int = _captured_default_background
    if _captured_colors_enabled and _captured_color_count > 0:
        if style.foreground is not None:
            foreground = nearest_terminal_color(
                style.foreground, _captured_color_count
            )
        if style.background is not None:
            background = nearest_terminal_color(
                style.background, _captured_color_count
            )
        if foreground is not None or style.background is not None:
            pair_foreground = foreground if foreground is not None else -1
            pair_key = (pair_foreground, background)
            pair = _captured_color_pairs.get(pair_key)
            if pair is None and _captured_next_color_pair < _captured_color_pair_count:
                try:
                    curses.init_pair(
                        _captured_next_color_pair, pair_foreground, background
                    )
                    pair = _captured_next_color_pair
                    _captured_color_pairs[pair_key] = pair
                    _captured_next_color_pair += 1
                except curses.error:
                    pair = None
            if pair is not None:
                attribute |= curses.color_pair(pair)

    if style.bold:
        attribute |= curses.A_BOLD
    if style.dim:
        attribute |= curses.A_DIM
    if style.italic:
        attribute |= getattr(curses, "A_ITALIC", 0)
    if style.underline:
        attribute |= curses.A_UNDERLINE
    if style.reverse:
        attribute |= curses.A_REVERSE
    if style.strike:
        attribute |= curses.A_DIM
    return attribute


def curses_add(
    screen: curses.window,
    y: int,
    x: int,
    value: str,
    attribute: int = curses.A_NORMAL,
    max_width: int | None = None,
) -> int:
    height, width = screen.getmaxyx()
    if y < 0 or y >= height or x < 0 or x >= width - 1:
        return x
    available = width - x - 1
    if max_width is not None:
        available = min(available, max_width)
    clipped = truncate_display(value, max(0, available))
    if not clipped:
        return x
    try:
        screen.addstr(y, x, clipped, attribute)
    except curses.error:
        return x
    return x + display_width(clipped)


def curses_add_busy(
    screen: curses.window,
    y: int,
    x: int,
    value: str,
    palette: dict[str, int],
    max_width: int | None = None,
) -> int:
    """Draw a short blue-to-purple label while preserving table alignment."""
    available = max_width if max_width is not None else display_width(value)
    clipped = truncate_display(value, max(0, available))
    visible_length = len(clipped.rstrip())
    if visible_length <= 0:
        return curses_add(screen, y, x, clipped, palette["normal"], available)
    start_x = x
    for index, character in enumerate(clipped):
        if index >= visible_length:
            attribute = palette["normal"]
        elif visible_length == 1:
            attribute = palette["busy_0"]
        else:
            color_index = round(index * 3 / (visible_length - 1))
            attribute = palette[f"busy_{color_index}"]
        x = curses_add(screen, y, x, character, attribute, 1)
    return max(x, start_x + display_width(clipped))


def preview_style(line: PreviewLine, palette: dict[str, int]) -> int:
    return {
        "user": palette["cyan"],
        "assistant": palette["normal"],
        "tool": palette["dim"],
        "working": palette["busy_2"],
        "addition": palette["green"],
        "deletion": palette["red"],
        "meta": palette["dim"],
        "body": palette["normal"],
    }.get(line.kind, palette["dim"])


def truncate_preview_line(line: PreviewLine, width: int) -> PreviewLine:
    clipped = truncate_display(line.text, width)
    if clipped == line.text:
        return line
    if not line.spans:
        return replace(line, text=clipped)
    suffix_length = 3 if clipped.endswith("...") else 0
    prefix_end = max(0, len(clipped) - suffix_length)
    spans = preview_span_slice(
        line,
        0,
        prefix_end,
        0,
        materialize_default=True,
    )
    if suffix_length:
        suffix_style = preview_style_at(line, max(0, prefix_end - 1))
        spans.append(
            PreviewSpan(prefix_end, len(clipped), suffix_style)
        )
    return replace(line, text=clipped, spans=merge_preview_spans(spans))


def preview_line_with_prefix(
    line: PreviewLine, prefix: str, *, strip_leading: bool = False
) -> PreviewLine:
    start = len(line.text) - len(line.text.lstrip()) if strip_leading else 0
    text = prefix + line.text[start:]
    if not line.spans:
        return replace(line, text=text)
    spans = [PreviewSpan(0, len(prefix), TerminalStyle())] if prefix else []
    spans.extend(
        preview_span_slice(
            line,
            start,
            len(line.text),
            len(prefix),
            materialize_default=True,
        )
    )
    return replace(line, text=text, spans=merge_preview_spans(spans))


def wrap_preview_line(line: PreviewLine, width: int) -> list[PreviewLine]:
    if line.kind == "blank":
        return [line]
    if line.kind == "separator":
        return [PreviewLine("─", "separator")]

    content = line.text.lstrip(" ")
    indentation = " " * min(8, len(line.text) - len(content))
    if not content:
        return [PreviewLine("", "blank")]
    continuation_indent = indentation + "  "
    wrapper = textwrap.TextWrapper(
        width=max(8, width),
        initial_indent=indentation,
        subsequent_indent=continuation_indent,
        break_long_words=True,
        break_on_hyphens=False,
        replace_whitespace=False,
        drop_whitespace=True,
    )
    parts = wrapper.wrap(content) or [indentation]
    wrapped: list[PreviewLine] = []
    content_cursor = 0
    content_start = len(line.text) - len(content)
    for index, part in enumerate(parts):
        prefix = indentation if index == 0 else continuation_indent
        body = part[len(prefix) :] if part.startswith(prefix) else part.lstrip()
        body_offset = content.find(body, content_cursor)
        if body_offset < 0:
            body_offset = content_cursor
        body_end = min(len(content), body_offset + len(body))
        content_cursor = body_end
        spans: tuple[PreviewSpan, ...] = ()
        if line.spans:
            span_list = (
                preview_span_slice(
                    line,
                    0,
                    content_start,
                    0,
                    materialize_default=True,
                )
                if index == 0
                else [PreviewSpan(0, len(prefix), TerminalStyle())]
            )
            span_list.extend(
                preview_span_slice(
                    line,
                    content_start + body_offset,
                    content_start + body_end,
                    len(prefix),
                    materialize_default=True,
                )
            )
            spans = merge_preview_spans(span_list)
        wrapped.append(
            truncate_preview_line(
                PreviewLine(part, line.kind, index > 0, spans), width
            )
        )
    return wrapped


def wrap_preview_lines(
    lines: tuple[PreviewLine, ...], width: int
) -> tuple[PreviewLine, ...]:
    wrapped: list[PreviewLine] = []
    for line in lines:
        wrapped.extend(wrap_preview_line(line, width))
    return tuple(wrapped)


def preview_window_from_wrapped(
    wrapped: tuple[PreviewLine, ...],
    rows: int,
    scroll_offset: int = 0,
) -> tuple[list[PreviewLine], int, int]:
    if rows <= 0:
        return [], 0, 0
    if not wrapped:
        return [], 0, 0

    max_offset = max(0, len(wrapped) - max(1, rows - 1))
    offset = max(0, min(scroll_offset, max_offset))
    end = max(0, len(wrapped) - offset)
    newer_hidden = end < len(wrapped)
    available = max(0, rows - (1 if newer_hidden else 0))
    start = max(0, end - available)
    older_hidden = start > 0
    if older_hidden:
        available = max(0, available - 1)
        start = max(0, end - available)

    shown = list(wrapped[start:end])
    while len(shown) > 1 and shown[0].continuation:
        shown.pop(0)
    if shown and shown[0].continuation:
        shown[0] = replace(
            preview_line_with_prefix(shown[0], "... ", strip_leading=True),
            continuation=False,
        )
    result: list[PreviewLine] = []
    if older_hidden:
        result.append(PreviewLine("… earlier transcript", "meta"))
    result.extend(shown)
    if newer_hidden:
        result.append(PreviewLine("… newer transcript below", "meta"))
    return result[-rows:], offset, max_offset


def preview_window(
    lines: tuple[PreviewLine, ...],
    width: int,
    rows: int,
    scroll_offset: int = 0,
) -> tuple[list[PreviewLine], int, int]:
    if width <= 0 or rows <= 0:
        return [], 0, 0
    return preview_window_from_wrapped(
        wrap_preview_lines(lines, width), rows, scroll_offset
    )


def wrapped_preview(
    lines: tuple[PreviewLine, ...],
    width: int,
    rows: int,
    scroll_offset: int = 0,
) -> list[PreviewLine]:
    return preview_window(lines, width, rows, scroll_offset)[0]


