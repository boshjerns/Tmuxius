def main() -> int:
    args = parse_args()
    if args.self_test:
        self_test()
        return 0

    enabled = sys.stdout.isatty() and not args.no_color and "NO_COLOR" not in os.environ
    if args.watch:
        return run_dashboard(args.socket, args.history_lines, args.interval, enabled)

    colors = Colors(enabled)
    try:
        sessions = list_sessions(args.socket)
    except TmuxError as exc:
        detail = str(exc).casefold()
        if any(
            marker in detail
            for marker in ("no server running", "no sessions", "cannot connect", "error connecting")
        ):
            print(f"\n{colors.bold}tmux workspaces{colors.reset}  {colors.dim}none open{colors.reset}\n")
            return 0
        print(f"\n{colors.bold}tmux workspaces{colors.reset}  {colors.dim}unavailable{colors.reset}\n")
        return 0

    if not sessions:
        print(f"\n{colors.bold}tmux workspaces{colors.reset}  {colors.dim}none open{colors.reset}\n")
        return 0
    try:
        print_report(sessions, args.socket, args.history_lines, colors)
    except TmuxError:
        print(f"\n{colors.bold}tmux workspaces{colors.reset}  {colors.dim}unavailable{colors.reset}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
