#!/usr/bin/env bash
set -euo pipefail
cd -- "$(git rev-parse --show-toplevel)"
python3 scripts/check-publication.py
command -v gitleaks >/dev/null || { printf 'Install Gitleaks before publishing; see CONTRIBUTING.md.\n' >&2; exit 1; }
gitleaks dir --redact --no-banner .
gitleaks git --redact --no-banner .
